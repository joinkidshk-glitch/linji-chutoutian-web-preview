 "nodes": {
  "R_lan_meet": {
   "start": true,
   "lines": [
    {
     "step": 0,
     "text": "主線 · 1991春\n          \n          通告牌下的人\n          星河電視台廠景門口；趕開早班，人多車多\n        \n  ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 1,
     "text": "藍若曦\n              哎呀——唔好意思，唔好意思，借過！（成疊通告牌\n            \n          \n        \n     ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_shy.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 764,
       "natH": 2352
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 2,
     "text": "阿偉蹲低幫佢一張一張執返，仲用背脊擋住人流，費事啲\n            \n          \n        \n        \n          下一",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 3,
     "text": "藍若曦\n              多謝你呀。我叫藍若\n            \n          \n        \n        \n          ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_smile.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 764,
       "natH": 2353
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 4,
     "text": "藍若曦\n              你嗰組仲差一個位未派……\n            \n          \n        \n        \n       ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 5,
     "text": "阿偉點咗點頭，嗰個位喺邊、嗰句唔好同人講，佢\n            \n          \n        \n        \n          下一句",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 6,
     "text": "落手幫忙：幫佢撳牌派通告佢對呢個肯幫手嘅後生仔，留下唔錯嘅第一印象。客氣疏離：只幫手執返啲牌你保持距離，冇行得太埋。",
     "lan": [],
     "speaker": "",
     "btns": [
      "落手幫忙：幫佢撳牌派通告佢對呢個肯幫手嘅後生仔，留下唔錯嘅第一印象。",
      "客氣疏離：只幫手執返啲牌你保持距離，冇行得太埋。"
     ]
    }
   ]
  },
  "R_lan_push1": {
   "start": true,
   "lines": [
    {
     "step": 0,
     "text": "主線 · 1991秋\n          \n          台慶嗰版通告牌\n          星河電視台後台走廊；台慶大騷綵排，成版通告牌亂到七彩\n   ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 1,
     "text": "藍若曦\n              唔好意思，你嗰場要押後兩位——前面嗰組跳舞嘅超時，我成版牌\n            \n          \n        ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_shy.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 764,
       "natH": 2352
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 2,
     "text": "阿偉見佢枱邊嗰盒飯凍晒都未開過，冇出聲，走埋去企喺佢側邊，等佢開口使喚。\n            \n          \n        \n        \n ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 3,
     "text": "藍若曦\n              唔使陪我捱㗎，你去食飯先啦。我呢啲場記命，邊有資格準時食飯——啲人埋晒位，我先有\n            \n        ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_shy.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 764,
       "natH": 2352
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 4,
     "text": "藍若曦\n              （佢笑住將一張改到花晒嘅流程表遞過嚟）你真係肯幫手？咁你幫我睇住呢幾格，我去\n            \n          ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 5,
     "text": "認真幫手：陪佢對晒成版牌一齊捱過台慶。只顧自己嗰場：對完自己嗰格就走工作界線。",
     "lan": [],
     "speaker": "",
     "btns": [
      "認真幫手：陪佢對晒成版牌一齊捱過台慶。",
      "只顧自己嗰場：對完自己嗰格就走工作界線。"
     ]
    }
   ]
  },
  "R_lan_crisis": {
   "start": true,
   "lines": [
    {
     "step": 0,
     "text": "主線 · 1992秋\n          \n          調組令\n          電視台人事部走廊；一張調組令，成層樓都知\n        \n    ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 1,
     "text": "藍若曦\n              外判嗰邊開嘅人工，多我而家一半。屋企人話，唔去就係傻—\n            \n          \n        \n ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 2,
     "text": "藍若曦\n              但係嗰度冇呢版通告牌，冇你哋呢班人……我係咪\n            \n          \n        \n      ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_sad.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 762,
       "natH": 2350
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 3,
     "text": "阿偉企喺度冇打斷佢。佢平時嗌人埋位嗰陣幾咁爽快，呢一刻把聲輕到好似驚\n            \n          \n        \n        \n   ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 4,
     "text": "藍若曦\n              你唔使答我㗎。我只係想講畀一個……會明嘅\n            \n          \n        \n        ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 5,
     "text": "陪佢爭取：同佢一齊同上頭講，留喺星河跟大騷企佢嗰邊，一齊爭取。勸佢為前途：去啦，唔好為呢度耽誤自己勸佢行，退後一步。",
     "lan": [],
     "speaker": "",
     "btns": [
      "陪佢爭取：同佢一齊同上頭講，留喺星河跟大騷企佢嗰邊，一齊爭取。",
      "勸佢為前途：去啦，唔好為呢度耽誤自己勸佢行，退後一步。"
     ]
    }
   ]
  },
  "R_lan_ending": {
   "start": true,
   "lines": [
    {
     "step": 0,
     "text": "主線 · 1992冬\n          \n          最後一版通告牌\n          星河電視台後台；年尾大騷煞科嗰晚\n        \n    ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 1,
     "text": "藍若曦\n              嗱，最後一版牌喇。你嗰格，我排得靚靚\n            \n          \n        \n        \n ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 2,
     "text": "阿偉望住自己嗰格。由第一日佢幫佢留位，到茶水間嗰啲閒話，再到今晚——佢\n            \n          \n        \n        \n  ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 3,
     "text": "藍若曦\n              第日你唔使人撳牌嗰陣……請返我食飯啦。一餐就夠，唔使山\n            \n          \n        \n ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 4,
     "text": "嗰句說話一出，阿偉心\n            \n          \n        \n        \n          下一句",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 5,
     "text": "藍若曦\n              講住先咋，唔\n            \n          \n        \n        \n          下一句",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(1)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 6,
     "text": "阿偉點頭，講咗句好。嗰餐飯，約好咗；嗰一步，冇行到。\n            \n          \n        \n        \n          下",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
       "x": 6,
       "y": 253,
       "w": 164,
       "h": 506,
       "op": "1",
       "filter": "brightness(0.6)",
       "natW": 792,
       "natH": 2448
      }
     ],
     "speaker": "",
     "btns": [
      "下一句",
      "下一句"
     ]
    },
    {
     "step": 7,
     "text": "走廊嗰頭有人嗌佢個名，佢應咗一聲，支筆往耳仔後面一夾，轉眼\n            \n          \n        \n        \n        ",
     "lan": [
      {
       "src": "assets/story/fullbody/lan_ruoxi_base.webp",
