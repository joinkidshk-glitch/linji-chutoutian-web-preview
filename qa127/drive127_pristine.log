  [s2_c9] synthetic StoryPlay.start(C9): True
  STORY s2_c9[0] spk=None line=1991 年冬，年尾清貨期。海港台附近嗰間老式酒廊，播住十幾年前嘅情歌。 chars=[]
  STORY s2_c9[1] spk=None line=酒廊門外，兩個劇組伙記揸住張糧單企咗成晚，見到何生嚟先散開半步。隔籬片場嗰套梟 chars=[]
  STORY s2_c9[2] spk=None line=酒廊門外，兩個劇組伙記揸住張糧單企咗成晚，見到何生嚟先散開半步。隔籬片場嗰套梟雄片啱啱開鏡，鞭炮聲傳到嚟呢邊——嗰邊風光，呢邊等錢。 chars=[]
  STORY s2_c9[3] spk=None line=年關呢兩個字，喺呢行唔係節日，係死線：租、糧、利是錢，全部排住隊嚟追人。 chars=[]
  STORY s2_c9[4] spk=何生 line=年尾啦，邊個都等錢過年。劇組有筆數拖咗三個月——源頭喺入面嗰位。 chars=[('awi', 'awi_base.webp'), ('ho_sang', 'ho_sang_base.webp')]
  STORY s2_c9[5] spk=何生 line=顧明輝，駐唱嗰個。佢唔係衰人，係真係冇。 chars=[('awi', 'awi_base.webp'), ('ho_sang', 'ho_sang_angry.webp')]
