    "src": "ENC",
    "speaker": "liu_bingxing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "liu_bingxing",
  "category": "sad",
  "expr": "sad",
  "source_bucket": "巧遇",
  "text": "做笑匠最攰嘅，唔係諗橋，係你幾唔開心都好，上到台都要畀人笑得出。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "liu_bingxing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "liu_bingxing",
  "category": "think",
  "expr": "think",
  "source_bucket": "巧遇",
  "text": "呢度啲奶茶，飲咗咁多年都係呢隻味，唔知係茶好，定係我念舊。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "liu_bingxing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
