 {
  "char": "ngai_wingnaam",
  "category": "happy",
  "expr": "smile",
  "source_bucket": "巧遇",
  "text": "嗯。放低就走啦……多謝。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "angry",
  "expr": "angry",
  "source_bucket": "巧遇",
  "text": "走啦。唔好學人哋咁八卦，武行嘅嘢，睇多都冇用。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "angry",
  "expr": "angry",
  "source_bucket": "巧遇",
  "text": "喂，嗰邊嗰個臨記後生仔，唔好企正後巷口，阻住人出入呀。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "serious",
  "expr": "serious",
  "source_bucket": "巧遇",
  "text": "後生仔，你嗰場企穩啲，鏡頭掃過嚟嗰陣唔好亂郁。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "serious",
  "expr": "serious",
  "source_bucket": "巧遇",
  "text": "你記住，紅唔紅係一陣風，企得穩，先至行得遠。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "think",
  "expr": "think",
  "source_bucket": "巧遇",
  "text": "而家人哋一聽我個名，就話諗下先，諗下先即係冇下文㗎喇。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "serious",
  "expr": "serious",
  "source_bucket": "巧遇",
  "text": "你想入動作組呀嘛？我講啲行內嘢你聽，你記住就好，唔好周圍唱。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "happy",
  "expr": "smile",
  "source_bucket": "巧遇",
  "text": "杯茶熱辣辣……多謝你，後生仔，你份心我記住。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "ngai_wingnaam",
  "category": "surprise",
  "expr": "surprise",
  "source_bucket": "巧遇",
  "text": "咦，阿偉嚟咗呀？坐低先啦，唔使企到咁生外。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "ngai_wingnaam",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "lok_gasing",
  "category": "angry",
  "expr": "angry",
  "source_bucket": "巧遇",
  "text": "冇運行？你都識講。行開啦後生仔，唔好阻住條走廊。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "lok_gasing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "lok_gasing",
  "category": "shy",
  "expr": "shy",
  "source_bucket": "巧遇",
  "text": "鍾意還鍾意，但電視台直情唔畀原創上大騷，話怕觀眾唔識欣賞。咁寫歌嗰啲人，係咪要餓死呀？",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "lok_gasing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "lok_gasing",
  "category": "shy",
  "expr": "shy",
  "source_bucket": "巧遇",
  "text": "換嚟做咩，佢陪我寫過咁多首歌，啲聲我一聽就認得，係老拍檔嚟㗎。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "lok_gasing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "lok_gasing",
  "category": "happy",
  "expr": "smile",
  "source_bucket": "巧遇",
  "text": "唔使你唱到幾勁，嗰段得幾句，你把聲夠實淨就得，我聽過你喺片場哼歌㗎。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "lok_gasing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "lok_gasing",
  "category": "angry",
  "expr": "angry",
  "source_bucket": "巧遇",
  "text": "哈，你都咁講？好，鬧完呢鋪，我返去寫歌，鬧人唔會寫到歌㗎。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "lok_gasing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "lok_gasing",
  "category": "surprise",
  "expr": "surprise",
  "source_bucket": "巧遇",
  "text": "咦，你又嚟呀？坐低啦，唔使企到咁拘謹。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "lok_gasing",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "chai_zanhoi",
  "category": "angry",
  "expr": "angry",
  "source_bucket": "巧遇",
  "text": "又係你？企遠少少，唔好阻住我默書。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "chai_zanhoi",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "chai_zanhoi",
  "category": "shy",
  "expr": "shy",
  "source_bucket": "巧遇",
  "text": "阿偉，嚟得啱喇，陪我行去化妝間，邊行邊講。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "chai_zanhoi",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "chai_zanhoi",
  "category": "shy",
  "expr": "shy",
  "source_bucket": "巧遇",
  "text": "後生嗰班追到好貼，個個識打識跳，鏡頭又鍾意佢哋嗰種新鮮感。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "chai_zanhoi",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "chai_zanhoi",
  "category": "happy",
  "expr": "smile",
  "source_bucket": "巧遇",
  "text": "台慶爭位，年年都爭，今年特別勁，邊個企前排、邊個壓軸出場，監製開咗幾次會都未定到。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "chai_zanhoi",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "chai_zanhoi",
  "category": "think",
  "expr": "think",
  "source_bucket": "巧遇",
  "text": "留低嘅亦唔一定係忠心，可能係驚去到新台冇位企。邊個會走邊個會留，要睇佢最近接咩戲，唔好睇佢把口。",
  "occurrences": [
   {
    "src": "ENC",
    "speaker": "chai_zanhoi",
    "reachable": true,
    "reach_why": "ENC"
   }
  ]
 },
 {
  "char": "chai_zanhoi",
  "category": "think",
  "expr": "think",
  "source_bucket": "巧遇",
  "text": "……你講得啱。名呢樣嘢，儲要十年，蝕只要一晚。我再諗清楚，先覆佢哋。",
