 "c1": [
  {
   "active": true,
   "kind": "system",
   "head": true,
   "line": "何生事務所嘅冷氣夠凍，檯面攤開兩份通告。",
   "speaker": "",
   "chars": [],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "system",
   "head": false,
   "line": "窗外走廊間中有人行過，帶住幾分呢行特有嘅急促。",
   "speaker": "",
   "chars": [],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "阿偉，你入行第一單嘢，我幫你睇咗兩條路。",
   "speaker": "何生",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "一份係跟張子駿個班底學做動作戲，勝在穩陣，不過人工就真係慢熱。",
   "speaker": "何生",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "另一份係去電影片場做散工，錢就快，但人脈隨時散水。",
   "speaker": "何生",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "學動作戲聽落紮實啲，不過去片場做散工又可以快啲見錢。",
   "speaker": "阿偉",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(1)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(0.6)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "呢兩條路真係各有千秋，要諗清楚先好決定。",
   "speaker": "阿偉",
   "chars": [
    {
     "id": "awi",
     "w": 163,
     "h": 487,
     "filter": "brightness(1)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(0.6)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "張子駿嗰邊主力喺星河電視台，學到嘢但捱得耐。",
   "speaker": "何生",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "片場嗰邊就周圍飛，現金快但無人當你係自己友。你自己諗清楚想點行先。",
   "speaker": "何生",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 176,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "（電話聲）何生，你嗰個新仔幾點到呀？",
   "speaker": "張子駿（電話聲）",
   "chars": [
    {
     "id": "cheung_tsijun",
     "w": 142,
     "h": 487,
     "filter": "brightness(0.8)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(0.8)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "我哋就快開鏡，等住佢埋位㗎！",
   "speaker": "張子駿",
   "chars": [
    {
     "id": "cheung_tsijun",
     "w": 142,
     "h": 487,
     "filter": "brightness(1)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(0.6)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "（對住電話）得啦得啦，一陣就叫佢過去。",
   "speaker": "何生",
   "chars": [
    {
     "id": "cheung_tsijun",
     "w": 142,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "（掛線）你聽到啦，張子駿催緊人。快啲揀啦，唔好阻住地球轉。",
   "speaker": "何生",
   "chars": [
    {
     "id": "cheung_tsijun",
     "w": 142,
     "h": 487,
     "filter": "brightness(0.6)"
    },
    {
     "id": "ho_sang",
     "w": 178,
     "h": 487,
     "filter": "brightness(1)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "我明白，呢個決定會影響我之後嘅發展。",
   "speaker": "阿偉",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(1)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(0.6)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "dialogue",
   "head": false,
   "line": "我諗好喇，就揀呢份。",
   "speaker": "阿偉",
   "chars": [
    {
     "id": "awi",
     "w": 167,
     "h": 487,
     "filter": "brightness(1)"
    },
    {
     "id": "ho_sang",
     "w": 177,
     "h": 487,
     "filter": "brightness(0.6)"
    }
   ],
   "modalBtns": [
    "下一句"
   ],
   "cards": [],
   "mapBarVis": "hidden"
  },
  {
   "active": true,
   "kind": "system",
   "head": false,
   "line": "兩份通告擺喺眼前，阿偉必須為自己做出一個抉擇。",
