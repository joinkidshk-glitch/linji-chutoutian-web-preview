  "nodes": [
    {
      "id": "C1",
      "phase": "P1",
      "title": "先練／先賺",
      "when": "1988春 / W3-4",
      "setting": "星河電視台廠景通告板旁，何生事務所",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "何生",
        "阿偉",
        "張子駿"
      ],
      "synopsis": "何生帶來兩條路。一條是跟張子駿的練功班底磨戲，較穩，但錢來得慢。另一條是趕通告，接電影散工臨記，錢快，但功夫未必有進。阿偉要在開工與練功之間先選一邊。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "現在擺在你面前有兩條路，你自己選一條來走。",
            "第一條是跟張子駿練功，他的班底比較穩定，戲會慢慢磨出來。",
            "另一邊，通告板剛剛貼出來，有電影散工，即日就有錢收。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "練功要練多久才能見到成果？",
            "趕通告又有多密集？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "練功的話，進度慢，收入也少。",
            "趕通告，錢來得快，但班底容易散。",
            "你想做演員，還是想做臨記？"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "（電話）我班底下星期開課。",
            "你肯來，我留位給你。",
            "不來，位置就留給別人了。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我知道。",
            "今日就要答覆。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "答之前想清楚。",
            "練功不會立刻見到錢。",
            "趕通告不會等你。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我選。",
            "不想兩邊都落空。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C1_a",
          "label": "先練班底：跟張子駿磨戲",
          "effects": {
            "flags": [
              "route_tv"
            ],
            "stats": {
              "craft": 1,
              "wealth": 0
            },
            "notes": "傾向電視廠景與班底磨練，較穩，收入慢。"
          }
        },
        {
          "id": "C1_b",
          "label": "先賺錢、趕通告：接電影散工臨記",
          "effects": {
            "flags": [
              "route_film"
            ],
            "stats": {
              "wealth": 1,
              "craft": 0
            },
            "notes": "傾向電影散工與趕通告，錢快，功夫靠自己。"
          }
        }
      ],
      "flags_written": [
        "route_tv",
        "route_film"
      ],
      "artId": "story_c1",
      "conflict": "T1"
    },
    {
      "id": "C2",
      "phase": "P1",
      "title": "留人脈／趕通告",
      "when": "1988春 / W4-5",
      "setting": "片場後巷，附近茶餐廳",
      "eraTag": "era_1988_spring_alley",
      "cast": [
        "何生",
        "阿偉",
        "林曉晴"
      ],
      "synopsis": "一場戲殺青，後巷有人約飯、交換名片。同一時間，下一輪通告板剛貼出。阿偉要決定留下應酬，還是趕去接下一張通告。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "剛才那組人說要約吃飯，說想多認識幾個臨記。",
            "他們還問你去不去，你要不要一起來？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "吃飯是幾點？通告板什麼時候貼出來？",
            "我想先搞清楚時間再決定。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "吃飯是今晚，通告板剛剛才貼出來。",
            "兩邊時間撞在一起，都很趕，你得選一個。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "去吃飯，可以累積人脈；看通告板，則是有工作機會。",
            "你自己衡量一下哪個對你比較重要。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "名片確實有用，但通告也有它的價值。",
            "兩個選擇好像都不錯，真難決定。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "留著人脈，日後有人會記得你；趕通告，今天就有錢賺。",
            "你別兩邊都落空，到頭來什麼都沒有。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我明白了，我會選一邊。",
            "不會讓自己兩頭空。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C2_a",
          "label": "留人脈：去後巷飯局，交換名片",
          "effects": {
            "flags": [
              "flag_network_stay"
            ],
            "stats": {
              "standing": 1,
              "wealth": 0
            },
            "notes": "人脈與何生態度正向，日後較易有人介紹工作。"
          }
        },
        {
          "id": "C2_b",
          "label": "趕通告：即刻去接下一張通告",
          "effects": {
            "flags": [
              "flag_hustle_board"
            ],
            "stats": {
              "wealth": 1,
              "craft": 0
            },
            "notes": "出勤與收入正向，何生略嘆但接受。"
          }
        }
      ],
      "flags_written": [
        "flag_network_stay",
        "flag_hustle_board"
      ],
      "artId": "story_c2",
      "conflict": null
    },
    {
      "id": "C3",
      "phase": "P1",
      "title": "對對手硬／忍",
      "when": "1988春 / W6-8",
      "setting": "星河電視台電影組通告板前，走廊人來人往",
      "eraTag": "era_1988_spring_factory",
      "cast": [
        "阿偉",
        "高俊傑",
        "林曉晴"
      ],
      "synopsis": "通告板貼出下周廠景名單。高俊傑當眾指阿偉走位慢，順手把阿偉的名牌從板上抽走。阿偉要決定硬碰還是忍讓。林曉晴在旁觀望，沒有出聲。",
      "beats": [
        {
          "speaker": "系統",
          "lines": [
            "通告欄前面圍了十幾個人，下星期廠景的名單剛剛貼上去。",
            "阿偉的名牌掛在第三行，位置不算好，但總算有他的名字。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "阿偉，你上次走位慢了半拍，整組人都在等你一個。",
            "這塊通告板，我先替你收著。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "名牌還給我。我走位慢，我會改。",
            "但名單不是你說抽走就抽走的。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "口氣不小。你知不知這塊通告板是誰排的？",
            "想拿回去，你自己去問。"
          ]
        },
        {
          "speaker": "系統",
          "lines": [
            "走廊靜了一瞬，有人低頭翻記數簿，有人裝作沒聽見。",
            "林曉晴站在人群邊，目光在兩人身上來回。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "好，我記住今日。",
            "通告板上的名，我會自己掛回去。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C3_a",
          "label": "硬碰：當面要回名牌，把話說清楚",
          "effects": {
            "flags": [
              "rival_gao_hard"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "高俊傑關係惡化；對手開始注意你"
          }
        },
        {
          "id": "C3_b",
          "label": "忍讓：不爭一時，先記下走位問題",
          "effects": {
            "flags": [
              "rival_gao_endure"
            ],
            "stats": {
              "craft": 1
            },
            "notes": "壓力暫緩；你觀察到對手排板的習慣"
          }
        }
      ],
      "flags_written": [
        "rival_gao_hard",
        "rival_gao_endure"
      ],
      "artId": "story_c3",
      "conflict": null
    },
    {
      "id": "C4",
      "phase": "P1",
      "title": "何生拒單",
      "when": "1988春 / W8-9",
      "setting": "何生事務所，桌面堆著記數簿與通告紙",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "何生",
        "阿偉"
      ],
      "synopsis": "何生帶來一份外判通告。工時寫得含糊，條款不清，片酬只有口頭承諾。何生主張拒單。阿偉可以跟何生，也可以自己硬接。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "這份通告，我看過了。工時寫八小時，實際會拖到十六。",
            "片酬只是口頭講，紙上一個字都沒有。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "多少錢？幾時出糧？有沒有寫進記數簿？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "沒有。所以我不簽。",
            "你要接，我不攔你，但別用我事務所的名。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我缺錢，但這張紙確實有問題。",
            "何生，你覺得我該怎麼做？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "我帶你入行，不是帶你接爛通告。拒了它。",
            "下一張通告，我幫你找。"
          ]
        },
        {
          "speaker": "系統",
          "lines": [
            "何生把通告紙推回桌邊，沒有再說話。",
            "阿偉看著紙上那行模糊的工時，手指停在半空。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C4_a",
          "label": "跟何生拒單，等下一張乾淨通告",
          "effects": {
            "flags": [
              "flag_refuse_gig_with_ho"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "何生信任升；收入不增，短期手頭更緊"
          }
        },
        {
          "id": "C4_b",
          "label": "自己硬接，先賺一筆再算",
          "effects": {
            "flags": [
              "flag_take_harsh_gig"
            ],
            "stats": {
              "wealth": 1,
              "standing": -1
            },
            "notes": "收入升；何生信任降，日後難開口"
          }
        }
      ],
      "flags_written": [
        "flag_refuse_gig_with_ho",
        "flag_take_harsh_gig"
      ],
      "artId": "story_c4",
      "conflict": null
    },
    {
      "id": "C5",
      "phase": "P1",
      "title": "采兒小訪題",
      "when": "1988夏 / W9-10",
      "setting": "片場邊的小桌，摺椅與保溫壺；午後光線偏白",
      "eraTag": "era_1988_summer_variety",
      "cast": [
        "周采兒",
        "阿偉"
      ],
      "synopsis": "星河台慶籌備的傳聞在片場流轉，獎項名單未到阿偉手上。周采兒好感足夠，約他在片場邊做一段小訪，只問片場日常與新人起步。她翻開筆記本，筆尖停在第一題。",
      "beats": [
        {
          "speaker": "周采兒",
          "lines": [
            "你先坐下來吧，這個訪問十分鐘就夠了。",
            "我只會問一些日常的事情，不會問那些傳聞。",
            "你第一天進片場的時候，最記得的是甚麼？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "最記得就是熱，燈一開，背脊全都濕透了。",
            "副導叫一次，我就跑一次，不敢慢下來。",
            "臨記站在邊位，其實只是在等一個眼神。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "等一個眼神，這句說得很好。",
            "有人說你近來多了很多通告。",
            "你自己怎樣看這件事？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "通告多，不代表就一定站得前。",
            "我還在學，很多東西都未掌握得好。",
            "學看機位，學收聲，一步一步來。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "星河台慶正在籌備，你應該聽過吧。",
            "我不會問你名單的事。",
            "我只想問，你想被記住成怎樣的一個人。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "（他停了一拍。）",
            "想被人記得我交得準，這樣就夠了。",
            "其他方面，我不敢講太多。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "好，最後一題了。",
            "新人起步，你覺得最難是甚麼？",
            "你照直說就可以，不用修飾。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "最難是等。",
            "等一個鏡頭，等一句對白。",
            "等到有了，就要接得住。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C5_a",
          "label": "誠實答：講等與怕，不修飾",
          "effects": {
            "flags": [
              "choi_honest"
            ],
            "stats": {
              "rel_choi": 2,
              "fame": 1
            },
            "notes": "她記下你肯講真話；稿子會留白位。"
          }
        },
        {
          "id": "C5_b",
          "label": "包裝答：講準備與專業，句子整齊",
          "effects": {
            "flags": [
              "choi_spin"
            ],
            "stats": {
              "rel_choi": 1,
              "fame": 2
            },
            "notes": "她照寫，但眼神多停了一秒。"
          }
        },
        {
          "id": "C5_c",
          "label": "迴避答：只講多謝，不談自己",
          "effects": {
            "flags": [
              "choi_dodge"
            ],
            "stats": {
              "rel_choi": 0,
              "fame": 0
            },
            "notes": "她記下你迴避；小訪提早收摺椅。"
          }
        }
      ],
      "flags_written": [
        "choi_honest",
        "choi_spin",
        "choi_dodge"
      ],
      "artId": "story_c5",
      "conflict": null
    }
