          "speaker": "系統",
          "emotion": null,
          "expression": null,
          "lines": [
            "何生事務所內煙霧彌漫，何生將本殘舊記數簿拍在枱面，旁邊放著張密密麻麻的通告紙。"
          ],
          "locId": "agency_ho",
          "bg": null
        },
        {
          "kind": "npc",
          "speakerId": null,
          "speaker": "何生",
          "emotion": null,
          "expression": null,
          "lines": [
