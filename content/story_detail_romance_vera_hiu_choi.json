    {
      "id": "R_hiu_crisis",
      "phase": "P4",
      "title": "同場搶通告",
      "when": "1990",
      "setting": "同場搶通告／試鏡廊",
      "eraTag": "era_1991_summer_anni",
      "cast": [
        "阿偉",
        "林曉晴"
      ],
      "synopsis": "在試鏡走廊碰上，兩個人原來正在爭同一個重要角色，要直接競爭。這段關係立刻受到考驗。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "估唔到會喺度撞到你，呢個角色對我嚟講好重要㗎，我準備咗好耐喇。",
            "我知你都好想要呢個機會，但最後得一個會揀得中，你會點做呀？"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉說他明白她的心情，這個角色這麼難得，誰不想爭。不過大家都是專業的，應該公平競爭。",
            "她說，無論結果如何，都不想影響兩個人之間的關係。朋友不是這麼容易認識到的。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "你講得啱，我哋係應該公平競爭嘅。不過我真係好需要呢個角色，希望你明啦。",
            "如果我輸咗，我可能會好唔開心，但我唔會怪你㗎。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉說他理解，自己也會盡力去試。沒有理由留手，留手反而對她不住。",
            "無論誰被選中，都應該替對方開心。她提議不如專心準備，拿出最好那一面來。"
          ]
        },
        {
          "speaker": "助導",
          "lines": [
            "兩位，準備入嚟喇。入到去唔使緊張，自然啲就得㗎喇。",
            "評審會睇你哋臨場反應，放鬆啲心情，當平時演戲咁就得喇。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_crisis_a",
          "label": "成全她",
          "effects": {
            "flags": [
              "flag_hiu_crisis_yield"
            ],
            "stats": {
              "rel_hiu": 2,
              "standing": -1
            },
            "notes": "阿偉成全她，把機會讓給她。"
          }
        },
        {
