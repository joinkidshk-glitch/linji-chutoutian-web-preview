  "nodes": [
    {
      "id": "R_hiu_meet",
      "phase": "P1",
      "title": "廠景休息角初遇",
      "when": "1988春",
      "setting": "廠景休息角",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "阿偉",
        "林曉晴"
      ],
      "synopsis": "阿偉在廠景休息角認識了同期臨記林曉晴。她主動走過來談通告情報，想跟阿偉交換消息，互相照應。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "你係咪今日先嚟呢個廠景㗎？我頭先聽到助導講，下晝嗰場戲要多幾個臨記喎。",
            "如果你有興趣，我可以幫你問下，不過你要快啲決定喇，啲位好快就畀人搶晒㗎。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉多謝她肯報料，說自己確實想多接通告，又問她是不是平日也這樣四處打聽。",
            "她提議交換情報，哪裏有機會就告訴對方，大家多一條路，不用一個人盲摸。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "好啊，我平時就係靠咁樣互相通報，先接到多啲工咋。",
            "不過你要記住呀，有啲助導好揀擇㗎，你要打聽清楚佢哋鍾意啲咩先，費事白行一趟。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉點頭，說會小心，又讚她肯分享。不是每個人都這麼好心，在這一行有個伴，總是好一些。",
            "她答應，之後一有消息，第一時間就告訴他。大家互相幫忙。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "咁就咁話喇。對喇，你叫咩名呀？我之後點搵你呀？",
            "我平時多數喺通告欄附近等消息，你嚟嗰度搵我就得喇。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_meet_a",
          "label": "交換情報",
          "effects": {
            "flags": [
              "flag_hiu_meet_exchange"
            ],
            "stats": {
              "rel_hiu": 1
            },
            "notes": "阿偉答應交換情報，兩個人互相通報，多一條路。"
          }
        },
        {
          "id": "C_hiu_meet_b",
          "label": "客氣疏離",
          "effects": {
            "flags": [
              "flag_hiu_meet_distant"
            ],
            "stats": {
              "rel_hiu": 0
            },
            "notes": "阿偉客氣疏離，沒有多談，兩個人保持距離。"
          }
        }
      ],
      "flags_written": [
        "flag_hiu_meet_distant",
        "flag_hiu_meet_exchange"
      ],
      "openConditions": [],
      "openConditionsNote": "林曉晴認識節；廠景同期。無額外旗閘。",
