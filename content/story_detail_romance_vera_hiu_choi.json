    {
      "id": "R_hiu_push1",
      "phase": "P1.5",
      "title": "茶餐廳互相帶通告",
      "when": "1988秋",
      "setting": "茶餐廳／廠景後門",
      "eraTag": "era_1988_autumn_unit",
      "cast": [
        "阿偉",
        "林曉晴"
      ],
      "synopsis": "兩個人在茶餐廳碰到，互相交換通告情報。曉晴提起星河電視台新劇試鏡，只剩兩個位置，兩個人之間有一點微妙競爭。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "我聽講下星期有個試鏡喎，星河電視台套新劇，要幾個後生臨記。",
            "我已經報咗名喇，你想去嘅話我哋可以一齊準備，不過啲位好似得返兩個咋。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉多謝她報料，問應該怎樣準備，有沒有什麼要特別留神。",
            "她又忍不住問，如果只有兩個位置，到時選不上的那一個，會不會介意。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "介意就梗有少少㗎喇，不過我哋係朋友，冇理由因為咁就反面嘅。",
            "不如各自準備啦，到時邊個表現好就邊個上，輸嗰個就幫對方慶祝囉。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉說這樣最好，公平競爭。他會認真準備，也希望她成功。",
            "她再問，這個角色要些什麼特質。不如互相給點意見，看看怎樣改好一些，練熟一些再去試。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "我諗佢哋想要嗰啲自然啲、唔造作嘅臨記，所以我哋要放鬆啲，唔好咁繃緊。",
            "仲有呀，打扮樸素啲就好，唔好太花枝招展，費事搶咗主角風頭就唔好喇。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_push1_a",
          "label": "幫她讓位，互相報料",
          "effects": {
            "flags": [
              "flag_hiu_push1_help"
            ],
            "stats": {
              "rel_hiu": 2
            },
            "notes": "阿偉幫她讓位，兩個人繼續互相報料。"
          }
        },
        {
          "id": "C_hiu_push1_b",
          "label": "自己先搶",
          "effects": {
            "flags": [
              "flag_hiu_push1_self"
            ],
            "stats": {
              "rel_hiu": -1,
              "standing": 1
            },
            "notes": "阿偉自己先搶，顧住自己的機會。"
          }
        }
      ],
      "flags_written": [
        "flag_hiu_push1_help",
        "flag_hiu_push1_self"
      ],
      "openConditions": [],
