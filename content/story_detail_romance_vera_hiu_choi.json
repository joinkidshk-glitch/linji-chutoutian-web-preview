    {
      "id": "R_vera_push1",
      "phase": "P1.5",
      "title": "形象會議",
      "when": "1988秋",
      "setting": "星河電視台形象會議室／試造型",
      "eraTag": "era_1988_autumn_unit",
      "cast": [
        "阿偉",
        "Vera"
      ],
      "synopsis": "電視台為阿偉安排形象改造，Vera 負責主導。兩人在會議上討論風格方向，阿偉的投入程度影響 Vera 對他的觀感。",
      "beats": [
        {
          "speaker": "Vera",
          "lines": [
            "這次形象改造，我想保留你的草根味，但加一點都市感，你覺得怎樣？"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉說信她的眼光，不過不想變成另一個人，觀眾認得他才重要。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "放心，我只是幫你整理，不是要你扮高級。你肯不肯花時間試多幾套？"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "阿偉答應，請她約時間，他會盡量配合。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "好，那我們下星期再試一次，到時我會準備幾套不同的配搭。"
          ]
        }
      ],
