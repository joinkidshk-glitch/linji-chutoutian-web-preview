{
  "nodes": [
    {
      "id": "A_ho_meet",
      "phase": "P1",
      "title": "事務所初帶",
      "when": "1988春",
      "setting": "星河電視台走廊，排隊等試鏡嘅人龍旁邊",
      "eraTag": "era_1988_spring",
      "cast": [
        "何生",
        "高俊傑"
      ],
      "synopsis": "何生喺走廊截住你，話你企位企錯晒，順手教你點樣喺人龍入面畀導演記得你個名。佢唔講大道理，只講邊個監製睇人睇邊樣。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "你企喺呢度等，等到天黑都冇人問你叫咩名。",
            "跟我行，我帶你認一認幾個監製嘅面口。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "何生帶人？咁你要聽話啲喇，佢唔鍾意人哋臨場先嚟問東問西。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "記住，呢行靠人帶，但帶得你入場，企唔企得穩係你自己嘅事。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ho_meet_follow",
          "label": "跟何生行一圈，逐個監製打招呼",
          "effects": {
            "flags": [
              "flag_ho_met",
              "flag_ho_intro_round"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 C2；何生開始記住你個名"
          }
        },
        {
          "id": "C_ho_meet_ask",
          "label": "先問清楚何生點解要幫你",
          "effects": {
            "flags": [
              "flag_ho_met",
              "flag_ho_asked_why"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 C2；何生覺得你審慎，但未算信你"
          }
        }
      ],
      "flags_written": [
        "flag_ho_asked_why",
        "flag_ho_intro_round",
        "flag_ho_met"
      ],
      "artId": "arc_ho_meet",
