    {
      "id": "A_ho_ending",
      "phase": "P5",
      "title": "穩陣線信任巔峰",
      "when": "1992",
      "setting": "星河電視台大堂，頒獎禮散場後人潮漸散",
      "eraTag": "era_1992_finale",
      "cast": [
        "何生",
        "高俊傑"
      ],
      "synopsis": "幾年過去，何生企喺大堂一角等你，講返當年走廊嗰句「呢行靠人帶」，然後問你之後想點行。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "當年我帶你入走廊，今日你自己行得入大堂。",
            "我唔會帶你一世，但你記得點樣帶下一個，就夠喇。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "何生講到呢句，即係真係睇得起你。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "你揀邊條路，我都唔會攔；不過揀之前，諗清楚邊個陪你捱過最凍嗰個冬天。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ho_ending_complete",
          "label": "認何生做一世師傅，留喺穩陣線",
          "effects": {
            "flags": [
              "flag_ho_mentor_complete"
            ],
            "stats": {
              "standing": 2
            },
            "notes": "mentor_complete；連 E01 師徒線收成"
          }
        },
        {
          "id": "C_ho_ending_respect",
          "label": "多謝何生，但想自己出去闖",
          "effects": {
            "flags": [
              "flag_ho_rival_respect"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "rival_respect；各自行，見面仲會點頭"
          }
        },
        {
          "id": "C_ho_ending_cold",
          "label": "當面講清條數，從此各行各路",
          "effects": {
