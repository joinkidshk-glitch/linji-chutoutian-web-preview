    {
      "id": "A_ho_crisis",
      "phase": "P4",
      "title": "賭大嘅信任考驗",
      "when": "1991冬",
      "setting": "何生事務所，暖爐壞咗，兩個人着住大褸講數",
      "eraTag": "era_1991_winter",
      "cast": [
        "何生",
        "張克凡"
      ],
      "synopsis": "何生押咗事務所大半本錢幫你爭一個大項目，另一邊有人出更高價撬你過檔，佢要你講清楚企邊邊。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "我押咗呢鋪，唔係押個項目，係押你個人。",
            "你走，我唔會攔，但你今日要走，以後唔好返嚟問我攞意見。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "何生，人哋出嘅價，你事務所跟唔跟得起先？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "跟唔跟得起係我嘅事，你淨係答我一句：你信唔信我揀嘅路。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ho_crisis_stay",
          "label": "留低，同何生一齊賭呢鋪",
          "effects": {
            "flags": [
              "flag_ho_crisis_stay",
              "flag_ho_big_bet"
            ],
            "stats": {
              "standing": 2
            },
            "notes": "連 E01；何生把身家押埋你一齊"
          }
        },
        {
          "id": "C_ho_crisis_leave",
          "label": "過檔，錢同前途要緊",
          "effects": {
            "flags": [
              "flag_ho_crisis_leave"
            ],
            "stats": {
              "standing": -2
            },
            "notes": "連 E01；何生冇鬧，只係收埋你張相"
          }
        },
        {
          "id": "C_ho_crisis_ask",
          "label": "要求何生講明風險先決定",
          "effects": {
            "flags": [
              "flag_ho_crisis_ask"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 E01；何生照講，但話你仲未夠膽"
          }
        }
      ],
      "flags_written": [
        "flag_ho_big_bet",
