    {
      "id": "A_ho_push1",
      "phase": "P1",
      "title": "拒單信任",
      "when": "1988春",
      "setting": "何生間細細嘅事務所，枱面擺住一疊通告紙",
      "eraTag": "era_1988_spring",
      "cast": [
        "何生",
        "張克凡"
      ],
      "synopsis": "有張出手好闊嘅單搵上門，錢多但條件糊塗，何生睇完搖晒頭，要你哋自己揀接唔接。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "呢張單錢係多，但條款寫到一舊雲，出事冇人同你孭。",
            "我唔會幫你接糊塗單，你要接，你自己簽名。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "何生，機會嚟到唔接，轉頭就畀第二個執咗去喇。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "執咗去就執咗去，總好過你收唔到錢仲要貼車錢。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ho_push1_refuse",
          "label": "聽何生講，推咗張糊塗單",
          "effects": {
            "flags": [
              "flag_ho_refused_deal",
              "flag_ho_trust_up"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 C4；何生信你識分寸"
          }
        },
        {
          "id": "C_ho_push1_take",
          "label": "照接，錢要緊，條款自己啃",
          "effects": {
            "flags": [
              "flag_ho_took_deal"
            ],
            "stats": {
              "standing": -1
            },
            "notes": "連 C4；何生面色一沉，記數簿度寫低一筆"
          }
        }
      ],
      "flags_written": [
        "flag_ho_refused_deal",
        "flag_ho_took_deal",
        "flag_ho_trust_up"
      ],
      "artId": "arc_ho_push1",
