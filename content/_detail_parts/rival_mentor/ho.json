    {
      "id": "A_ho_push2",
      "phase": "P2",
      "title": "通告品質把關",
      "when": "1989",
      "setting": "深夜嘅片場外圍，何生攞住張通告表逐項圈",
      "eraTag": "era_1989",
      "cast": [
        "何生",
        "高俊傑"
      ],
      "synopsis": "你開始多咗通告，何生逐張同你核對，話你知邊張係消耗你、邊張係幫你儲底。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "呢張通宵廠景，拍足十二個鐘得三個鏡頭，你話值唔值？",
            "我幫你推咗兩張，留返精神拍下個禮拜嗰組。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "何生幫你篩通告，你唔好連句多謝都冇。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "唔使多謝，你拍得好睇，我個名都好聽啲。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ho_push2_trust",
          "label": "交畀何生篩，自己專心拍戲",
          "effects": {
            "flags": [
              "flag_ho_quality_trust"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "何生把關通告品質，你專心演出"
          }
        },
        {
          "id": "C_ho_push2_self",
          "label": "自己揀通告，唔想乜都靠人",
          "effects": {
            "flags": [
              "flag_ho_self_select"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "何生冇嬲，但話你遲早要學識睇數"
          }
        }
      ],
      "flags_written": [
        "flag_ho_quality_trust",
        "flag_ho_self_select"
      ],
      "artId": "arc_ho_push2",
      "conflict": "通告量同品質拉鋸；何生要你唔好做蝕底嘅工",
      "parallelOk": true,
      "pcSilent": true,
      "arcLine": "ho",
      "arcKind": "mentor",
      "arcBeat": "push"
