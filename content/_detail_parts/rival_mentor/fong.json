  "nodes": [
    {
      "id": "A_fong_meet",
      "phase": "P1",
      "title": "茶餐廳兩份早餐",
      "when": "1988",
      "setting": "旺角舊式茶餐廳，卡位油漬斑斑，吊扇慢轉",
      "eraTag": "era_1988",
      "cast": [
        "方小龍",
        "高俊傑"
      ],
      "synopsis": "你同方小龍由細喺武館識到大，佢而家做武師替身，成日大嗓門拍你膊頭。今日佢拉你嚟茶餐廳，話有門路介紹你入星河電視台做臨記，順便講下自己棚入面嘅辛酸。",
      "beats": [
        {
          "speaker": "方小龍",
          "lines": [
            "喂！好耐冇見你咁瘦嘅？坐低坐低，我請！",
            "我而家跟高師傅個棚，做替身做到周身瘀，不過有飯食就唔怕。",
            "你唔係一直想入行咩？星河電視台聽日有場廠景要人，我幫你搭路。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "小龍你個朋友？手腳睇落幾實淨，不過臨記還臨記，唔好諗住一步登天。"
          ]
        },
        {
          "speaker": "方小龍",
          "lines": [
            "高師傅你唔好嚇佢啦，我哋由細打到大，佢食得苦嘅！"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_fong_meet_take",
          "label": "多謝小龍，跟佢去星河見識下",
          "effects": {
            "flags": [
              "flag_fong_met",
              "flag_fong_intro_sent"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_fong_push1；小龍介紹你入星河廠景"
          }
        },
        {
          "id": "C_fong_meet_ask",
          "label": "問清楚替身有幾危險先決定",
          "effects": {
            "flags": [
              "flag_fong_met",
              "flag_fong_warned"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 A_fong_push1；你對替身風險有心理準備"
          }
        }
      ],
      "flags_written": [
        "flag_fong_intro_sent",
        "flag_fong_met",
        "flag_fong_warned"
      ],
      "artId": "arc_fong_meet",
