    {
      "id": "A_fong_push1",
      "phase": "P2",
      "title": "武師棚推進",
      "when": "1989",
      "setting": "星河電視台舊廠棚，木搭高台同軟墊，燈光刺眼",
      "eraTag": "era_1989",
      "cast": [
        "方小龍",
        "張克凡"
      ],
      "synopsis": "廠景開拍，方小龍喺棚入面做替身跳高台，你喺下面做臨記。張克凡做武指，要求愈嚟愈高。小龍跳完一次，拍你膊頭話仲頂得住，但腳已經有啲拐。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "呢個鏡頭要一次過，唔好NG，跳唔到就換人。"
          ]
        },
        {
          "speaker": "方小龍",
          "lines": [
            "得！我跳！你喺下面睇住我位，唔好行開。",
            "跳完呢場我請你食宵夜，哈哈！"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "小龍你腳點？唔得就出聲，唔好死頂。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_fong_push1_watch",
