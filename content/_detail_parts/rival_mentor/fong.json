    {
      "id": "A_fong_ending",
      "phase": "P5",
      "title": "動作班底兩條路",
      "when": "1992",
      "setting": "星河電視台新廠棚外，黃昏，貨車同道具箱堆滿空地",
      "eraTag": "era_1992_finale",
      "cast": [
        "方小龍",
        "張克凡",
        "高俊傑"
      ],
      "synopsis": "兩年過去，動作班底重組。方小龍傷後復出，問你仲會唔會同佢一齊捱。張克凡想拉你入新班底，高俊傑就話規矩要講清楚。你要揀點行落去。",
      "beats": [
        {
          "speaker": "方小龍",
          "lines": [
            "喂！我隻腳好返七成，夠膽同你一齊再跳！",
            "你唔會唔記得我哋由茶餐廳講到而家嘛？"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "新班底要人，你身手我睇住大，考慮下。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "跟邊個都好，合約同安全要寫清楚，唔好又死頂。"
          ]
        }
      ],
