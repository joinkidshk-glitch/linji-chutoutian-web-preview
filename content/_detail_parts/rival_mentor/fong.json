    {
      "id": "A_fong_push2",
      "phase": "P3",
      "title": "外銷高峰練功夜",
      "when": "1990夏",
      "setting": "星河電視台天台，夜燈同水塔，遠處霓虹招牌",
      "eraTag": "era_1990_summer",
      "cast": [
        "方小龍",
        "高俊傑"
      ],
      "synopsis": "動作片外銷高峰，棚入面通告密到爆。方小龍收工拉你上天台練功，話唔練就追唔上。高俊傑路過，講起替身行情同班底規矩。",
      "beats": [
        {
          "speaker": "方小龍",
          "lines": [
            "嚟啦！打多兩套，我今日仲有氣！",
            "你呢排跟得幾好，遲啲我同張師傅講，畀你做多啲位。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "練功係好，但班底有班底規矩，唔好淨係靠一股蠻力。"
          ]
        },
        {
          "speaker": "方小龍",
          "lines": [
            "高師傅你放心，我哋唔會亂嚟！"
          ]
        }
      ],
