    {
      "id": "A_fong_crisis",
      "phase": "P3",
      "title": "替身危機",
      "when": "1990夏",
      "setting": "星河電視台廠棚，高台邊緣同濕滑地板，現場一片混亂",
      "eraTag": "era_1990_summer_stunt",
      "cast": [
        "方小龍",
        "張克凡",
        "高俊傑"
      ],
      "synopsis": "一場高台跳躍戲，方小龍做替身，落地時腳一滑，半邊身掛喺台邊。張克凡叫停，高俊傑喺下面喝住。你要即刻決定點做。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "停！全部停手！小龍你捉實個邊，唔好亂動！"
          ]
        },
        {
          "speaker": "方小龍",
          "lines": [
            "我……我頂得住……你唔好過嚟，個台唔穩！"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "邊個負責安全帶？點會咁鬆？快啲搵人上去！"
          ]
        }
      ],
