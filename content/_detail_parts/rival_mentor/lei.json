    {
      "id": "A_lei_ending",
      "phase": "P5",
      "title": "危險盟友或決裂",
      "when": "1992",
      "setting": "一間已經丟空嘅舊片場，佈景拆剩一半，雷勁一個人坐喺導演椅上，手上轉住一支筆。",
      "eraTag": "era_1992_finale",
      "cast": [
        "雷勁",
        "張克凡"
      ],
      "synopsis": "幾年過去，雷勁嘅勢力唔同以前，你亦唔再係當年嗰個新人。佢約你喺舊片場見面，話想「埋尾」，但講到尾都係要你表態：做佢盟友，定係各行各路。",
      "beats": [
        {
          "speaker": "雷勁",
          "lines": [
            "呢個廠，我第一次做武師就係喺度俾人踢落樓梯。",
            "今日我坐喺度，你估我仲會唔會俾人踢？"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "雷生，你搵我嚟，唔係淨係想懷舊啩。",
            "你想我點表態，不如直接講。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "好，爽快。",
            "我而家要人幫手睇住盤數，你肯埋嚟，以前啲嘢我當冇發生。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "你唔肯，我都唔會攔你。",
            "不過你要記住，我呢個人，唔會忘記邊個喺我低谷嗰陣走咗。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lei_ending_ally",
          "label": "應承做盟友，但講明底線",
          "effects": {
