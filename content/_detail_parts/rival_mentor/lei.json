    {
      "id": "A_lei_push2",
      "phase": "P2",
      "title": "低成本動作片班底拉攏",
      "when": "1989",
      "setting": "新界一間改裝貨倉，用嚟拍低成本動作片，地下有軟墊，牆邊擺住幾支木棍同威也。",
      "eraTag": "era_1989",
      "cast": [
        "雷勁",
        "張克凡"
      ],
      "synopsis": "雷勁搞緊一部低成本動作片，想搵你入班底做主角，話係機會，但合約條件一樣苛，仲要你兼做替身同宣傳。佢帶你睇貨倉，語氣似賞識又似試探。",
      "beats": [
        {
          "speaker": "雷勁",
          "lines": [
            "你睇下呢個倉，我租咗半年，夠我拍三套。",
            "我唔係大公司，但我肯用新人，你喺星河企幾年先等到一個主角？"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "雷生，你份約寫明要我做替身，仲要自己出錢買戲服？",
            "咁樣叫機會？"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "叫捱出頭呀後生仔。",
            "我當年跳樓梯都係自己買護膝，你估成功係免費嘅？"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "你唔做，出面大把人排隊。",
            "不過我睇得起你，先同你講咁多。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lei_push2_join",
          "label": "應承入班底，但要改兩條條款",
          "effects": {
            "flags": [
              "flag_lei_push2",
              "flag_lei_deal"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_lei_crisis；雷勁肯讓一小步，但記住你夠膽講價"
          }
        },
        {
          "id": "C_lei_push2_refuse",
          "label": "婉拒，話想留喺電視台發展",
          "effects": {
