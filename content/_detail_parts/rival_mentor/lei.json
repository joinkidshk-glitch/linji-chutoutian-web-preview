{
  "nodes": [
    {
      "id": "A_lei_meet",
      "phase": "P1.5",
      "title": "茶餐廳攤約",
      "when": "1988秋",
      "setting": "旺角一間舊式茶餐廳，卡位油漬未抹乾淨，雷勁坐喺最入面嗰張枱，面前擺住一疊文件同兩杯凍奶茶。",
      "eraTag": "era_1988_autumn",
      "cast": [
        "雷勁",
        "張克凡"
      ],
      "synopsis": "雷勁透過中間人約你見面，話想傾「合作」，實際上係想睇你係咪一個可以收歸旗下嘅人。佢一開口就笑住講以前做龍虎武師點樣捱，笑完就將一份合約推到你面前。",
      "beats": [
        {
          "speaker": "雷勁",
          "lines": [
            "坐啦，唔使企喺度，我唔食人嘅。",
            "我雷勁以前都係喺片場俾人呼喝嗰個，捱到今日，你估靠咩？靠識做人。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "雷生，你約我嚟，係想傾戲定係傾人？",
            "我聽講你手上啲合約，簽咗就好難甩身。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "哈哈，你個細路幾直接，我鍾意。",
            "合約呢啲嘢，你情我願，簽之前睇清楚，冇人揸住你隻手簽。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "不過我話你知，跟我搵食，最少唔會俾人恰。",
            "你考慮下，唔急，但機會唔會等人太耐。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lei_meet_read",
          "label": "攞起合約逐條睇清楚先講",
          "effects": {
            "flags": [
              "flag_lei_met",
              "flag_lei_contract_read"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_lei_push1；睇清條款，雷勁覺得你唔係蠢人"
          }
        },
        {
          "id": "C_lei_meet_polite",
          "label": "客氣推搪，話要同公司商量",
          "effects": {
            "flags": [
              "flag_lei_met"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 A_lei_push1；雷勁表面笑笑，心裏記住你耍太極"
          }
        },
        {
          "id": "C_lei_meet_bluff",
          "label": "扮晒有後台，唔好意思拒絕",
          "effects": {
            "flags": [
              "flag_lei_met",
              "flag_lei_bluff"
            ],
            "stats": {
              "standing": -1
            },
            "notes": "連 A_lei_push1；雷勁最憎人扮嘢，日後會查你底"
          }
        }
      ],
      "flags_written": [
        "flag_lei_bluff",
        "flag_lei_contract_read",
        "flag_lei_met"
      ],
      "artId": "arc_lei_meet",
      "conflict": "雷勁想收你入旗下，你想保住自主；合約條款苛刻，簽與唔簽都係壓力。",
      "arcBeat": "meet",
      "parallelOk": true,
      "pcSilent": true,
      "arcLine": "lei",
      "arcKind": "capital"
