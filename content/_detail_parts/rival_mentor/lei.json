    {
      "id": "A_lei_crisis",
      "phase": "P1.5",
      "title": "拒苛刻合約危機",
      "when": "1988秋冬",
      "setting": "雷勁嘅寫字樓，枱面擺住合約同一個計數簿，窗外係舊樓天台。",
      "eraTag": "era_1988_winter_contract",
      "cast": [
        "雷勁",
        "高俊傑"
      ],
      "synopsis": "雷勁要你即刻簽一份長約，年期長、抽佣高、違約罰得重，仲話唔簽就當你唔俾面。你拒絕之後，佢冇即刻發惡，只係慢慢合上計數簿，講咗句令你心寒嘅說話。",
      "beats": [
        {
          "speaker": "雷勁",
          "lines": [
            "份約我改過，已經好俾面你。",
            "你簽咗，我擔保你三年內有戲拍；你唔簽，我唔敢講。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "雷生，違約罰款寫到咁重，你當人係賣身？",
            "我哋唔會簽呢種嘢。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "賣身？哈哈，我賣咗十幾年先有今日。",
            "你哋唔簽，我唔會逼，不過呢行好細，消息好快傳。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "我雷勁講義氣，但義氣係留俾自己人。",
            "你哋走出呢個門口之前，想清楚。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lei_crisis_refuse",
          "label": "當面拒絕，話唔會簽呢種約",
          "effects": {
            "flags": [
              "flag_lei_crisis",
              "flag_anti_lei"
            ],
            "stats": {
              "standing": 2
            },
            "notes": "連 A_lei_ending；雷勁記住你唔俾面，日後或成對頭"
          }
        },
        {
          "id": "C_lei_crisis_negotiate",
          "label": "提出反建議，拉高自己籌碼",
          "effects": {
            "flags": [
              "flag_lei_crisis",
              "flag_lei_negotiated"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_lei_ending；雷勁覺得你難纏但有腦，關係未斷"
          }
        },
        {
          "id": "C_lei_crisis_sign",
          "label": "頂唔住壓力，簽咗先算",
          "effects": {
            "flags": [
