    {
      "id": "A_lei_push1",
      "phase": "P1.5",
      "title": "脅迫推進",
      "when": "1988秋冬",
      "setting": "星河電視台停車場出口，夜晚，雷勁靠住一架舊平治，兩個手下企遠少少食煙。",
      "eraTag": "era_1988_winter",
      "cast": [
        "雷勁",
        "高俊傑"
      ],
      "synopsis": "雷勁開始出手，先係叫你嘅通告被「技術性」調走，再喺停車場截住你，語氣半笑半嚇，話呢行好現實，唔埋堆就會被邊緣化。",
      "beats": [
        {
          "speaker": "雷勁",
          "lines": [
            "你近排啲通告，好似少咗喎。",
            "我唔知關唔關我事，不過呢行好多嘢，都係一句說話嘅啫。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "雷生，你咁樣做好唔好睇呀？",
            "人哋唔簽你，你就玩呢啲？"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "我玩咩呀？我不知幾得閒。",
            "後生仔，我係提你，唔係嚇你，唔好將好心當狗肺。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lei_push1_stand",
          "label": "企硬，話唔會因為咁就範",
          "effects": {
            "flags": [
              "flag_lei_push1",
              "flag_lei_defiant"
            ],
            "stats": {
              "standing": 2
            },
            "notes": "連 A_lei_crisis；雷勁覺得你有骨氣，但會加大壓力"
          }
        },
        {
          "id": "C_lei_push1_soften",
          "label": "低調安撫，話有機會再傾",
          "effects": {
            "flags": [
              "flag_lei_push1"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 A_lei_push2；雷勁當你鬆口，之後更纏身"
          }
        },
        {
          "id": "C_lei_push1_seek_help",
          "label": "搵高俊傑幫手擋一擋",
          "effects": {
            "flags": [
              "flag_lei_push1",
              "flag_ko_ally"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_lei_crisis；高俊傑應承，但欠咗一個人情"
          }
        }
      ],
      "flags_written": [
