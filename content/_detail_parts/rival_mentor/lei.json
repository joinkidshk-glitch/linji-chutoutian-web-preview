              "flag_lei_push2",
              "flag_lei_refuse_film"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 A_lei_crisis；雷勁面色一沉，話你唔識貨"
          }
        },
        {
          "id": "C_lei_push2_probe",
          "label": "問清楚片酬同分帳先算",
          "effects": {
            "flags": [
