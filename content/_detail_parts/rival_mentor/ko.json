      "when": "1988夏",
      "setting": "星河電視台一號錄影廠，處境劇圍讀同走位排練",
      "eraTag": "era_1988_summer",
      "cast": [
        "高俊傑"
      ],
      "synopsis": "圍讀時高俊傑刻意搶你句對白嘅節奏，走位又霸住你個位，副導在場睇住邊個執生快。",
      "beats": [
        {
          "speaker": "高俊傑",
          "lines": [
            "你企嗰個位擋住我入鏡呀，唔該借借。",
            "我頭先試咗個新節奏，副導都話順，你唔好跟唔上喎。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "你個名我記住咗，不過係因為你成日慢半拍。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "喂，唔好淨係望住我，你都有戲要交㗎。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ko_push1_counter",
          "label": "即場改節奏反壓佢，畀副導睇你執生",
