    {
      "id": "A_ko_ending",
      "phase": "P4",
      "title": "賀歲片場再遇",
      "when": "1991夏",
      "setting": "星河電視台賀歲片廠景，兩人多年後再同場",
      "eraTag": "era_1991_summer",
      "cast": [
        "高俊傑"
      ],
      "synopsis": "賀歲片開鏡，你同高俊傑多年後再同場，佢主動行埋嚟，講返當年搶板同台慶嘅事。",
      "beats": [
        {
          "speaker": "高俊傑",
          "lines": [
            "喂，好耐冇見，你個名而家唔使我讀都有人識啦。",
            "當年台慶個位，我而家諗返都覺得自己幼稚。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "我唔會話你贏咗，不過我認你係一個值得企埋一齊嘅對手。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "今次場戲，我哋唔好再搶位啦，好唔好？"
          ]
        }
      ],
