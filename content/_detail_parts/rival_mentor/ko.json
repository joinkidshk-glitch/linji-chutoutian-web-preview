  "nodes": [
    {
      "id": "A_ko_meet",
      "phase": "P1",
      "title": "搶板初遇",
      "when": "1988春",
      "setting": "星河電視台二號錄影廠外走廊，臨時演員排隊等派通告",
      "eraTag": "era_1988_spring",
      "cast": [
        "高俊傑"
      ],
      "synopsis": "你排隊等派通告，高俊傑突然插隊搶走你手上嗰張板紙通告，仲要當眾讀出你個名來激你。",
      "beats": [
        {
          "speaker": "高俊傑",
          "lines": [
            "喂，呢個位我早排咗，你仲唔識趣？",
            "你個名咁難讀，難怪副導都記唔住你啦。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "我唔係星二代，我係自己一步一步捱上嚟，你呢？企喺度等運到？"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "算啦，今日我心情好，張通告還返你，不過下次唔好要我開口。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_ko_meet_grab",
          "label": "搶返通告機會，企硬唔讓",
          "effects": {
            "flags": [
              "flag_ko_met_grab"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 C3；高俊傑記住你唔係軟腳蟹"
          }
        },
        {
          "id": "C_ko_meet_yield",
          "label": "讓佢一次，睇清楚佢咩底細",
          "effects": {
            "flags": [
              "flag_ko_met_yield"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 C3；高俊傑覺得你識做，但心底睇低你"
          }
        }
      ],
      "flags_written": [
        "flag_ko_met_grab",
        "flag_ko_met_yield"
      ],
