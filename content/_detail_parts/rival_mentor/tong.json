    {
      "id": "A_tong_push2",
      "phase": "P2",
      "title": "去留一句鉤",
      "when": "1989",
      "setting": "星河電視台走廊，夜晚，排練完結後唐素雲叫住你。",
      "eraTag": "era_1989_leave",
      "cast": [
        "唐素雲",
        "張克凡"
      ],
      "synopsis": "唐素雲用一句說話鉤住你，要你諗清楚係咪真係想喺呢行留低。",
      "beats": [
        {
          "speaker": "唐素雲",
          "lines": [
            "我睇你排咗成日，你係有啲嘢嘅。但係你呢行，唔係淨係靠有啲嘢。",
            "有人走，有人留。你諗清楚，你係邊種人。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "唐老師好少咁同人講嘢，你執到啦。",
            "不過佢把口係咁，你唔好太在意。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "我唔係要你即刻答我。我淨係想你記住，你今日點解會企喺度。",
            "如果你連自己點解留低都唔知，咁你走都唔會走得遠。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tong_push2_stay",
          "label": "同唐老師講，你想留低學嘢",
          "effects": {
            "flags": [
              "flag_tong_push2_stay"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_tong_crisis"
          }
        },
        {
          "id": "C_tong_push2_doubt",
          "label": "坦白同唐老師講，你仲未諗清楚",
          "effects": {
            "flags": [
              "flag_tong_push2_doubt"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 A_tong_crisis，唐素雲覺得你仲有得諗"
          }
        }
      ],
