            },
            "notes": "連 A_tong_push1"
          }
        },
        {
          "id": "C_tong_meet_watch",
          "label": "企喺門口繼續睇，唔敢行入去",
          "effects": {
            "flags": [
              "flag_tong_met_watch"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 A_tong_push1，但唐素雲對你印象較淺"
          }
        }
      ],
      "flags_written": [
