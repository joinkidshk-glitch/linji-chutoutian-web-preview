    {
      "id": "A_tong_crisis",
      "phase": "P3",
      "title": "是否繼續跟她磨",
      "when": "1990",
      "setting": "星河電視台排練室，深夜，唐素雲同你排一場重頭戲，你頻頻NG。",
      "eraTag": "era_1990",
      "cast": [
        "唐素雲",
        "高俊傑"
      ],
      "synopsis": "你哋排咗成晚，唐素雲開始失去耐性，高俊傑喺旁邊冷嘲熱諷，你要決定係咪繼續跟唐素雲磨落去。",
      "beats": [
        {
          "speaker": "唐素雲",
          "lines": [
            "你今日心不在焉。你係咪有嘢想同我講？",
            "我唔係要你交戲，我要你交心。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "唐老師，佢跟咗你成年都係咁，不如算啦。",
            "有啲人係冇天份嘅，你教幾耐都冇用。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "我教戲，唔係淨係教天份。我教嘅係，你點樣面對自己唔得嘅時候。",
            "你今日可以走，但係你走咗，就唔好返嚟同我講你想做戲。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tong_crisis_stay",
          "label": "留低，繼續跟唐老師磨",
          "effects": {
