              "flag_tong_push1_argue"
            ],
            "stats": {
              "standing": -1
            },
            "notes": "連 A_tong_push2，唐素雲覺得你未開竅"
          }
        }
      ],
      "flags_written": [
        "flag_tong_push1_accept",
        "flag_tong_push1_argue"
      ],
      "artId": "arc_tong_push1",
      "conflict": "唐素雲的嚴格要求 vs 你對自己演法的堅持。",
