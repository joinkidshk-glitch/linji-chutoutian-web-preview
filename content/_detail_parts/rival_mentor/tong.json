    {
      "id": "A_tong_push1",
      "phase": "P2",
      "title": "演技矯正",
      "when": "1989夏",
      "setting": "星河電視台二號排練室，黃昏，唐素雲單對單指導你。",
      "eraTag": "era_1989_summer",
      "cast": [
        "唐素雲"
      ],
      "synopsis": "唐素雲逐句矯正你的唸白，要你放低演嘢，用真感情。",
      "beats": [
        {
          "speaker": "唐素雲",
          "lines": [
            "你頭先句對白，感情係假嘅。你只係喺度讀字，唔係喺度做人。",
            "你試下諗一件你真係好驚嘅事，然後用嗰種驚去講呢句對白。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "做戲唔係要你喊，係要你忍。忍唔住嗰下，觀眾先會喊。",
            "你太想表現，反而冇咗自己。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "我後生嗰陣，都係咁樣俾人鬧大嘅。",
            "有人走，有人留。你留得低，就要對得住自己。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tong_push1_accept",
          "label": "虛心接受，照唐老師方法重新演一次",
          "effects": {
            "flags": [
              "flag_tong_push1_accept"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 A_tong_push2"
          }
        },
        {
          "id": "C_tong_push1_argue",
          "label": "覺得自己方法冇問題，同唐老師理論",
          "effects": {
