{
  "nodes": [
    {
      "id": "A_tong_meet",
      "phase": "P2",
      "title": "旁聽點名",
      "when": "1989",
      "setting": "星河電視台排練室，下午，陽光斜照，唐素雲正為幾位新人試戲。",
      "eraTag": "era_1989",
      "cast": [
        "唐素雲",
        "高俊傑",
        "張克凡"
      ],
      "synopsis": "你混入排練室旁聽，唐素雲點名要你即場演一段，考你膽量同反應。",
      "beats": [
        {
          "speaker": "唐素雲",
          "lines": [
            "後生仔，你企喺門口咁耐，不如行入嚟試一段。",
            "做戲唔係鬥快，係鬥真。你畀我睇下你有幾真。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "唐老師，佢都係嚟八卦下啫，使唔使咁認真？",
            "我哋仲有好多嘢要排。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "我教戲咁多年，邊個有火，我一眼睇得出。",
            "你唔試，就永遠都係企喺門口嗰個。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tong_meet_step_in",
          "label": "行入去，照唐老師指示演一段",
          "effects": {
