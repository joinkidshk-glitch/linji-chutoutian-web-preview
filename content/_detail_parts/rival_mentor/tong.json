    {
      "id": "A_tong_ending",
      "phase": "P5",
      "title": "教室窗邊的去留",
      "when": "1992",
      "setting": "星河電視台天台，黃昏，唐素雲約你見面，話有嘢同你講。",
      "eraTag": "era_1992_finale",
      "cast": [
        "唐素雲"
      ],
      "synopsis": "唐素雲話你知，佢要退休喇，問你記唔記得當初點解留低，並將佢嘅演戲心得交託畀你。",
      "beats": [
        {
          "speaker": "唐素雲",
          "lines": [
            "我教咗咁多年，係時候退落嚟。",
            "你係我最後一個學生，我想你記住，做戲先做人。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "有人走，有人留。你留得低，就要幫手睇住呢個地方。",
            "我冇乜嘢可以留畀你，淨係得呢句。"
          ]
        },
        {
          "speaker": "唐素雲",
          "lines": [
            "你以後嘅路，你自己行。但係你記住，你曾經喺我度學過嘢。",
            "唔好失禮我。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tong_ending_mentor",
          "label": "承諾會記住唐老師教誨，繼續做戲",
