    {
      "id": "A_hakfan_crisis",
      "phase": "P4",
      "title": "廠期危機，兩條船同一條水",
      "when": "1991",
      "setting": "星河電視台製作部會議室，臨時召開《赤道線》續集危機會議，佈景費同廠期都出咗問題。",
      "eraTag": "era_1991",
      "cast": [
        "張克凡",
        "監製周世昌",
        "副導演芬姐"
      ],
      "synopsis": "續集資金出事，電視台想削減廠期，你同張克凡嘅重頭戲隨時被剪。監製要人孭飛同外間製作公司傾，張克凡手上有人脈，你有草根觀眾緣，兩條路本來唔相交，而家要揀聯手定各自保命。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "我爸爸識外間公司個老闆，我可以搭路，但唔擔保人哋肯見你。",
            "你唔好以為我想幫你，我只係唔想成套劇死喺廠期度。"
          ]
        },
        {
          "speaker": "監製周世昌",
          "lines": [
            "兩個都係我簽返嚟嘅，邊個搞得掂我唔理，總之廠期要保住。",
            "你哋自己傾，傾唔掂我剪戲。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "我出人脈，你出你把口去說服班伙記撐住。做唔做，一句。"
          ]
        }
      ],
      "choices": [
