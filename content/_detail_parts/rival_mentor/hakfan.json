    {
      "id": "A_hakfan_push2",
      "phase": "P3",
      "title": "同一場戲，兩種演法",
      "when": "1990",
      "setting": "星河電視台五號錄影廠，《赤道線》中段重頭戲排練，導演要求一次過排完整場對手戲。",
      "eraTag": "era_1990",
      "cast": [
        "張克凡",
        "導演陸志明",
        "場務強哥"
      ],
      "synopsis": "排練場上你同張克凡正面對戲。佢用世家出身嘅方法拆解角色，你用地道草根嘅演法回應。導演未叫停，全廠都喺度睇邊個帶得住場。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "你呢句對白咁樣講，觀眾會覺得你冇準備。",
            "唔係話你唔啱，不過我喺屋企同爸爸對過呢場，個節奏唔係咁。"
          ]
        },
        {
          "speaker": "導演陸志明",
          "lines": [
            "兩個都唔好停，我睇緊邊個版本啱個角色。",
            "克凡，你放慢少少；你，唔好跟佢個節奏，做返你自己。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "好，我唔跟劇本，我跟你。你出咩，我接咩。",
            "做戲最緊要係對手夠唔夠膽，你夠膽就嚟。"
          ]
        }
      ],
      "choices": [
