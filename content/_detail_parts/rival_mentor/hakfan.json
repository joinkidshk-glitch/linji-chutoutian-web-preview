    {
      "id": "A_hakfan_push1",
      "phase": "P2",
      "title": "人脈飯局搶走嘅角色",
      "when": "1989夏",
      "setting": "星河電視台製作部樓層，佈告板啱啱貼出《赤道線》casting名單，隔籬茶水間有人講緊昨晚飯局。",
      "eraTag": "era_1989_summer",
      "cast": [
        "張克凡",
        "助導阿森",
        "監製周世昌"
      ],
      "synopsis": "名單出咗，角色落喺張克凡手上。你喺茶水間撞到佢，佢唔否認係飯局傾返嚟，仲話呢行本來就係咁行。你手上只剩一個戲份少嘅配角位，要決定爭唔爭。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "名單你睇咗啦？我唔會扮意外，個角色係我爭返嚟。",
            "你可以話我靠屋企，但我入到廠一樣要交戲，唔會白坐。"
          ]
        },
        {
          "speaker": "助導阿森",
          "lines": [
            "克凡，監製叫你落去試造型。",
            "喂，你仲未走？配角個位仲未覆實，你要就快啲應。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "配角都係戲，做得好監製會睇到。不過你留低，就要預咗俾人比較。"
          ]
        }
      ],
      "choices": [
        {
