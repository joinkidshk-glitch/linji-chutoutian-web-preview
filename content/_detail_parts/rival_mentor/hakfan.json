    {
      "id": "A_hakfan_meet",
      "phase": "P2",
      "title": "試鏡房門外嘅世家子弟",
      "when": "1989春",
      "setting": "星河電視台三號試鏡房走廊，牆上貼住新劇《赤道線》角色表，長櫈坐滿等叫名嘅演員。",
      "eraTag": "era_1989_spring",
      "cast": [
        "張克凡",
        "副導演芬姐",
        "助導阿森"
      ],
      "synopsis": "你喺走廊等試鏡，張克凡由芬姐親自帶入房，連排隊都唔使。佢臨入房前望你一眼，語氣唔重但句句都係資源壓人，話呢個角色早有人打過招呼。你未入房已經知道，呢場唔止考演技。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "你係咪都係等《赤道線》？我勸你唔好嘥心機，呢個位我爸爸同監製食過飯。",
            "唔係話你唔得，不過電視台啲嘢，有時係講邊個開口先。"
          ]
        },
        {
          "speaker": "副導演芬姐",
          "lines": [
            "克凡，監製叫你入去先，試完再講。",
            "後面嗰位，你準備定，下一輪到你。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "我試完出嚟同你講聲，睇下你輸喺邊。做戲呢家嘢，輸都要輸得明白。"
          ]
        }
      ],
      "choices": [
