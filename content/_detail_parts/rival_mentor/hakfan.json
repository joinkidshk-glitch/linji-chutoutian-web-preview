    {
      "id": "A_hakfan_ending",
      "phase": "P5",
      "title": "頒獎禮後台，兩種收場",
      "when": "1992",
      "setting": "星河電視台台慶頒獎禮後台化妝間，獎項啱啱頒完，走廊仲傳嚟掌聲。",
      "eraTag": "era_1992_finale",
      "cast": [
        "張克凡",
        "副導演芬姐",
        "記者群"
      ],
      "synopsis": "幾年較量去到台慶夜。你同張克凡喺後台化妝間撞正，獎項塵埃落定。佢望住你，第一次冇用家世開場，而係講演技。你點回應，決定呢條敵線點收。",
      "beats": [
        {
          "speaker": "張克凡",
          "lines": [
            "今晚個獎邊個攞都好，我認你係我遇過最難接嘅對手。",
            "我由細到大都係人哋讓我先，你冇讓過，所以我記住你。"
          ]
        },
        {
          "speaker": "副導演芬姐",
          "lines": [
            "兩個都唔好企喺走廊，記者影緊相。",
            "克凡，你爸爸喺前面等你；你，監製叫你過去。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "我唔會同你講咩友誼萬歲，不過下次有戲，我想同你再對一次。",
            "你揀啦，係咪都要做敵人。"
          ]
        }
      ],
