    {
      "id": "A_gao_ending",
      "phase": "P5",
      "title": "金牌推手嘅最後一句",
      "when": "1992",
      "setting": "星河電視台天台，黃昏，遠處係九龍嘅樓景，風有點大",
      "eraTag": "era_1992_finale",
      "cast": [
        "高文瀚",
        "張克凡"
      ],
      "synopsis": "幾年過去，高文瀚約你上天台。佢話自己手上嘅資源開始要分畀新人，問你覺得自己企唔企得穩。你點答，決定佢係繼續做你嘅推手，定係慢慢撤走啲資源。",
      "beats": [
        {
          "speaker": "高文瀚",
          "lines": [
            "我手上嘅位開始要分畀第二啲人。你唔好問我點解，你問自己企唔企得穩。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "（同你細聲）佢肯約你上天台，即係仲當你係自己人。"
          ]
        },
        {
          "speaker": "高文瀚",
          "lines": [
            "呢個位我話事，但我唔可以永遠話事。你答我一句，你想我繼續推你，定係想我放手。"
          ]
        }
      ],
