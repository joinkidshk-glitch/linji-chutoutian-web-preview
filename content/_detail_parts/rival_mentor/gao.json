    {
      "id": "A_gao_meet",
      "phase": "P2",
      "title": "試鏡房嘅第一眼",
      "when": "1989春",
      "setting": "星河電視台七樓試鏡房，長枱後面坐住三個監製，窗外係春天濕漉漉嘅廣播道",
      "eraTag": "era_1989_spring",
      "cast": [
        "高文瀚",
        "張克凡",
        "助導阿玲"
      ],
      "synopsis": "你喺走廊等咗成個鐘，入到試鏡房，高文瀚冇叫你自我介紹，淨係叫你讀手上嗰頁劇本。你讀完，佢冇即刻評語，反而問你一句：你覺得呢場戲，個角色係想贏定係想走？你答完，佢先慢慢揭返你嘅履歷。",
      "beats": [
        {
          "speaker": "高文瀚",
          "lines": [
            "唔使自我介紹，我唔想聽你背稿。你讀呢頁，讀完我問你嘢。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "（細聲）高生今日心情唔錯，你執生啦。"
          ]
        },
        {
          "speaker": "高文瀚",
          "lines": [
            "你覺得呢場戲，個角色係想贏，定係想走？呢個答案冇標準，但我要聽你真心嗰個。"
          ]
        },
        {
          "speaker": "高文瀚",
          "lines": [
            "好，我記住你。呢個位我話事，唔係因為你演得最好，係因為你肯答我問題。"
          ]
        }
      ],
      "choices": [
        {
