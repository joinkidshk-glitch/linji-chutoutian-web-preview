    {
      "id": "A_gao_push1",
      "phase": "P2",
      "title": "搶位要趁早",
      "when": "1989",
      "setting": "星河電視台服裝間外面嘅走廊，通告板貼滿手寫紙仔，人來人往",
      "eraTag": "era_1989",
      "cast": [
        "高文瀚",
        "張克凡",
        "助導阿玲"
      ],
      "synopsis": "高文瀚手上有一個二線角色嘅位，幾個人爭。佢冇明講畀邊個，只係喺走廊撞到你，同你講咗句「你知唔知自己爭緊咩」。你要喺佢面前展示你值得個位，定係乖乖等安排。",
      "beats": [
        {
          "speaker": "高文瀚",
          "lines": [
            "呢個位好多人吼住，我唔會因為你可憐就畀你。你知唔知自己爭緊咩？"
          ]
        },
        {
          "speaker": "助導阿玲",
          "lines": [
            "高生，張生嗰邊催緊回覆，話今日要覆。"
          ]
        },
        {
          "speaker": "高文瀚",
          "lines": [
            "叫佢等。呢個位我話事，我未諗完就冇人覆得住。"
          ]
        },
        {
          "speaker": "張克凡",
          "lines": [
            "（同你細聲）佢肯同你講呢句，即係你仲有機會，唔好嘥。"
          ]
        }
      ],
      "choices": [
