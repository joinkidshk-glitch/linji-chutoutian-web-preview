    {
      "id": "A_tsijun_push2",
      "phase": "P2",
      "title": "商業同文藝兩張通告",
      "when": "1989春",
      "setting": "星河電視台大堂，兩張通告同時貼喺佈告板：一張係大騷綜藝嘉賓，一張係張子駿嘅影展短片試鏡。",
      "eraTag": "era_1989_spring",
      "cast": [
        "張子駿",
        "高俊傑"
      ],
      "synopsis": "高俊傑幫你爭到綜藝大騷嘅位，話曝光難得。張子駿同時遞上短片試鏡邀請，講明冇錢、冇人氣，但會送去影展。你只可以揀一張通告。",
      "beats": [
        {
          "speaker": "高俊傑",
          "lines": [
            "呢個大騷位，我幫你講到口水乾。你上到去企三分鐘，全港都識你。"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "我唔阻你。不過你問下自己，你想人記得你個名，定記得你嗰場戲。",
            "影展唔係靠人氣，係靠你肯唔肯慢慢磨戲。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "張導，你個影展幾時先有人睇？廠方睇收視㗎。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tsijun_push2_film",
          "label": "揀張子駿嘅短片試鏡，放棄大騷",
          "effects": {
            "flags": [
              "flag_tsijun_push2_film"
            ],
