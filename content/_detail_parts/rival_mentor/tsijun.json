              "flag_tsijun_met_stay"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 C1；張子駿記住你肯留低"
          }
        },
        {
          "id": "C_tsijun_meet_leave",
          "label": "跟高俊傑走，先接廠期通告",
          "effects": {
            "flags": [
              "flag_tsijun_met_leave"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 T1；張子駿冇攔你，但眼神沉一沉"
          }
        }
      ],
      "flags_written": [
        "flag_tsijun_met_leave",
        "flag_tsijun_met_stay"
      ],
