    {
      "id": "A_tsijun_crisis",
      "phase": "P3",
      "title": "曝光同層次",
      "when": "1990秋",
      "setting": "影展放映室，外面落緊雨。張子駿嘅短片入圍一個小單元，你喺片入面只有一個長鏡頭。",
      "eraTag": "era_1990_autumn",
      "cast": [
        "張子駿",
        "高俊傑"
      ],
      "synopsis": "短片放映後，有發行商想剪走你嗰個長鏡頭，換成節奏快嘅版本，話咁先有人氣。張子駿堅持保留，高俊傑就話機會難得。你被夾喺中間。",
      "beats": [
        {
          "speaker": "張子駿",
          "lines": [
            "嗰個長鏡頭係成套戲嘅心。剪走咗，你演嘅嘢就變佈景。",
            "你想人記得你，就要人記得你點樣企喺個鏡頭入面。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "發行商話剪短啲先有人睇。張導，你唔好同錢鬥氣啦。"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "我唔係同錢鬥氣，我係同你講，層次剪唔走。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tsijun_crisis_hold",
          "label": "公開支持張子駿，企硬保留長鏡頭",
