{
  "nodes": [
    {
      "id": "A_tsijun_meet",
      "phase": "P1",
      "title": "練功房的第一課",
      "when": "1988春",
      "setting": "星河電視台舊廠大樓三樓，單元劇練功房。牆身油漆剝落，鏡前鋪住一塊起毛嘅地膠，角落擺住一疊手寫分鏡紙。",
      "eraTag": "era_1988_spring",
      "cast": [
        "張子駿",
        "高俊傑"
      ],
      "synopsis": "你被派去單元劇練功房試鏡，遇到文藝導演張子駿。佢唔急住睇你演戲，反而叫你喺鏡前企定，慢慢講一次自己點解想做戲。高俊傑喺門口探頭，催你唔好嘥時間。",
      "beats": [
        {
          "speaker": "張子駿",
          "lines": [
            "唔使急，企定先。你望住塊鏡，諗清楚自己想喺鏡入面見到咩人。",
            "影展唔係靠人氣，係靠你肯唔肯喺一個鏡頭入面磨到自己都怕。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "喂，張導，呢個新人我哋廠等住用㗎，你唔好同佢磨到天黑啦。"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "天黑就天黑。你返去同上面講，戲未磨好，我唔會放人。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tsijun_meet_stay",
          "label": "留低跟張子駿慢慢磨，唔理外面催",
          "effects": {
