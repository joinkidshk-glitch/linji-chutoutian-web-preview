    {
      "id": "A_tsijun_ending",
      "phase": "P5",
      "title": "評審席上嘅熟面口",
      "when": "1992",
      "setting": "影展頒獎禮後台走廊，張子駿坐喺評審席隔籬嘅休息位，手上仲揸住節目表。",
      "eraTag": "era_1992_finale",
      "cast": [
        "張子駿",
        "高俊傑"
      ],
      "synopsis": "幾年過去，你喺影展再遇張子駿。佢望住你，話你個樣熟口熟面，但問你仲記唔記得當初練功房嗰堂。高俊傑喺旁邊等緊你過去應酬。",
      "beats": [
        {
          "speaker": "張子駿",
          "lines": [
            "你個樣，我熟口熟面。不過我想知，你仲記唔記得練功房塊鏡。",
            "影展唔係靠人氣，係靠你仲肯唔肯慢慢磨戲。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "喂，前面個酒會等緊你㗎，唔好喺度企咁耐啦。"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "你去啦。不過我行過咁多屆評審席，認得邊個係磨出嚟，邊個係企出嚟。"
          ]
        }
      ],
      "choices": [
