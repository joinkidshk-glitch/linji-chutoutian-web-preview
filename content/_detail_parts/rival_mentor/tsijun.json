    {
      "id": "A_tsijun_push1",
      "phase": "P1.5",
      "title": "單元劇班底",
      "when": "1988秋",
      "setting": "星河電視台二號錄影廠，單元劇《夜行街》佈景。凌晨兩點，劇組食完外賣，燈光師喺度換燈泡。",
      "eraTag": "era_1988_autumn",
      "cast": [
        "張子駿",
        "高俊傑"
      ],
      "synopsis": "張子駿把你收入單元劇班底，要你演一個只有三場戲嘅小角色。高俊傑嫌你曝光太少，話廠方想換個有話題嘅人。張子駿頂住壓力，叫你喺排練房再磨一次。",
      "beats": [
        {
          "speaker": "張子駿",
          "lines": [
            "三場戲夠唔夠？夠。你喺第三場嗰個回頭，我要觀眾記十年。",
            "唔好理人氣，人氣會散，層次唔會。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "張導，廠方話收視要緊，換個有新聞嘅人企喺度，觀眾先會留低。"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "咁你叫廠方自己嚟同我講。我個班底，我話事。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_tsijun_push1_grind",
          "label": "留喺排練房，同張子駿磨到收廠",
          "effects": {
            "flags": [
              "flag_tsijun_push1_grind"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "連 C8；張子駿開始當你係自己班底"
          }
        },
        {
          "id": "C_tsijun_push1_side",
          "label": "私下應承高俊傑，兩邊都唔得罪",
          "effects": {
            "flags": [
              "flag_tsijun_push1_side"
            ],
            "stats": {
              "standing": 0
            },
            "notes": "連 C8；張子駿後來會知你兩頭走"
          }
        }
      ],
      "flags_written": [
        "flag_tsijun_push1_grind",
        "flag_tsijun_push1_side"
      ],
      "artId": "arc_tsijun_push1",
      "conflict": "收視話題同演出層次拉扯；張子駿守住班底，高俊傑要廠方交代。",
      "arcBeat": "push",
      "parallelOk": true,
