{
  "nodes": [
    {
      "id": "C1",
      "phase": "P1",
      "title": "先練／先賺",
      "when": "1988春 / W3-4",
      "setting": "星河電視台廠景通告板旁，何生事務所",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "何生",
        "阿偉",
        "張子駿"
      ],
      "synopsis": "何生帶來兩條路。一條是跟張子駿的練功班底磨戲，較穩，但錢來得慢。另一條是趕通告板，接電影散工臨記，錢快，但功夫未必有進。阿偉要在開工與練功之間先選一邊。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "兩條路，你自己揀。",
            "跟張子駿練，班底穩，戲會磨出來。",
            "另一邊，通告板剛貼，電影散工，即日有錢。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "練功要幾耐？",
            "趕板又幾密？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "練功，慢。錢少。",
            "趕板，快。人散。",
            "你想做演員，還是想做臨記？"
          ]
        },
        {
          "speaker": "張子駿",
          "lines": [
            "（電話）我班底下星期開課。",
            "你肯來，我留位。",
            "唔來，位就俾人。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我知。",
            "今日要答。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "答之前想清楚。",
            "練功唔會即刻見錢。",
            "趕板唔會等你。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我揀。",
            "唔想兩頭唔到岸。"
          ]
        }
      ],
      "choices": [
