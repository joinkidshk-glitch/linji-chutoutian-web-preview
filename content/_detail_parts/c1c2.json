    {
      "id": "C2",
      "phase": "P1",
      "title": "留人脈／趕板",
      "when": "1988春 / W4-5",
      "setting": "片場後巷，附近茶餐廳",
      "eraTag": "era_1988_spring_alley",
      "cast": [
        "何生",
        "阿偉",
        "林曉晴"
      ],
      "synopsis": "一場戲殺青，後巷有人約飯、交換名片。同一時間，下一輪通告板剛貼出。阿偉要決定留下應酬，還是趕去接下一張通告。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "剛才那組人話約飯。",
            "話想識多幾個臨記。",
            "你去唔去？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "幾點？",
            "通告板幾時貼？"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "飯，今晚。",
            "板，剛剛貼。",
            "兩邊都趕。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "飯，有人脈。",
            "板，有工開。",
            "你自己秤。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "名片有用。",
            "通告都有用。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "留人，日後有人記得你。",
            "趕板，今日有錢。",
            "唔好兩邊都甩。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我明。",
            "我揀一邊。"
          ]
        }
      ],
      "choices": [
