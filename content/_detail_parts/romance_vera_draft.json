{
  "nodes": [
    {
      "id": "R_vera_meet",
      "phase": "P1",
      "title": "造型間初遇",
      "when": "1988春夏",
      "setting": "星河電視台造型間／試裝",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "阿偉",
        "Vera"
      ],
      "synopsis": "阿偉第一次到星河電視台試造型，Vera 是當值的造型師。她一眼看出阿偉的草根氣質，語氣帶點挑剔，卻又忍不住給了一句忠告，留下一個小鉤子。",
      "beats": [
        {
          "speaker": "Vera",
          "lines": [
            "你就是新來的臨記？這件襯衫顏色太鮮，鏡頭前會搶戲，換一件素色的。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我第一次來試造型，不太懂規矩，你直接告訴我怎樣穿就好。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "規矩就是：你站在鏡頭前，觀眾第一眼看到的是整體感覺，不是你的演技。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "那我這身打扮，給你的第一感覺是甚麼？"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "很草根，但眼神有火。這種矛盾，用得好就是你的特色。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "多謝你肯講真話，我會記住這句。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_vera_meet_warm",
          "label": "暖場：多謝提點，虛心請教",
          "effects": {
            "flags": [
              "flag_vera_met_warm"
            ],
            "stats": {
              "rel_vera": 1,
              "craft": 1
            }
          },
          "notes": "阿偉態度誠懇，Vera 對他留下不錯的印象。"
        },
        {
          "id": "C_vera_meet_cold",
          "label": "冷淡：點頭就走，趕下一個通告",
          "effects": {
            "flags": [
              "flag_vera_met_cold"
            ],
            "stats": {
              "rel_vera": 0,
              "fame": 1
            }
          },
          "notes": "阿偉沒有多留，Vera 覺得他有點酷，但未至於反感。"
        }
      ],
      "flags_written": [
        "flag_vera_met_warm",
        "flag_vera_met_cold"
      ],
      "artId": "rom_vera_meet",
      "conflict": null,
      "romanceLine": "vera",
      "arcBeat": "meet"
    },
    {
      "id": "R_vera_push1",
      "phase": "P1.5",
      "title": "形象會議",
      "when": "1988秋",
      "setting": "星河電視台形象會議室／試造型",
      "eraTag": "era_1988_autumn_unit",
      "cast": [
        "阿偉",
        "Vera"
      ],
      "synopsis": "電視台為阿偉安排形象改造，Vera 負責主導。兩人在會議上討論風格方向，阿偉的投入程度影響 Vera 對他的觀感。",
      "beats": [
        {
          "speaker": "Vera",
          "lines": [
            "這次形象改造，我想保留你的草根味，但加一點都市感，你覺得怎樣？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我信你的眼光，不過我不想變成另一個人，觀眾認得我才重要。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "放心，我只是幫你整理，不是要你扮高級。你肯不肯花時間試多幾套？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "肯，你約時間，我盡量配合。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "好，那我們下星期再試一次，到時我會準備幾套不同的配搭。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_vera_push1_cooperate",
          "label": "認真配合：花時間試造型",
          "effects": {
            "flags": [
              "flag_vera_cooperate"
            ],
            "stats": {
              "rel_vera": 2,
              "craft": 1
            }
          },
          "notes": "Vera 欣賞阿偉的專業態度，關係升溫。"
        },
        {
          "id": "C_vera_push1_perfunctory",
          "label": "敷衍：求其試一套就算",
          "effects": {
            "flags": [
              "flag_vera_perfunctory"
            ],
            "stats": {
              "rel_vera": 0,
              "fame": 1
            }
          },
          "notes": "Vera 覺得阿偉不夠投入，印象分略減。"
        }
      ],
      "flags_written": [
        "flag_vera_cooperate",
        "flag_vera_perfunctory"
      ],
      "artId": "rom_vera_push1",
      "conflict": null,
      "romanceLine": "vera",
      "arcBeat": "push"
    },
    {
      "id": "R_vera_push2",
      "phase": "P2",
      "title": "茶餐廳小聚",
      "when": "1989",
      "setting": "茶餐廳小聚",
      "eraTag": "era_1989_spring",
      "cast": [
        "阿偉",
        "Vera"
      ],
      "synopsis": "阿偉與 Vera 在茶餐廳偶遇，難得坐下來閒聊。Vera 問起阿偉的過去，阿偉可以選擇坦白心事，還是只談工作。",
      "beats": [
        {
          "speaker": "Vera",
          "lines": [
            "很少見你一個人來茶餐廳，今天不用趕通告嗎？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "剛剛拍完一場戲，趁有空檔來吃個下午茶。你呢？"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "我剛從服裝間出來，順便來買杯奶茶。你近來好像很搏命。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "不搏命不行，機會不是經常有的。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "除了工作，你有沒有其他想做的事？"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_vera_push2_honest",
          "label": "坦白心事：講自己的過去與夢想",
          "effects": {
            "flags": [
              "flag_vera_honest"
            ],
            "stats": {
              "rel_vera": 2,
              "craft": 1
            }
          },
          "notes": "Vera 覺得阿偉真誠，兩人距離拉近。"
        },
        {
          "id": "C_vera_push2_work",
          "label": "只談工作：保持專業距離",
          "effects": {
            "flags": [
              "flag_vera_worktalk"
            ],
            "stats": {
              "rel_vera": 1,
              "fame": 1
            }
          },
          "notes": "Vera 有點失望，但明白阿偉以事業為重。"
        }
      ],
      "flags_written": [
        "flag_vera_honest",
        "flag_vera_worktalk"
      ],
      "artId": "rom_vera_push2",
      "conflict": null,
      "romanceLine": "vera",
      "arcBeat": "push"
    },
    {
      "id": "R_vera_crisis",
      "phase": "P4",
      "title": "打歌後台的抉擇",
      "when": "1991秋",
      "setting": "打歌現場後台／電台",
      "eraTag": "era_1991_autumn_promo",
      "cast": [
        "阿偉",
        "Vera"
      ],
      "synopsis": "阿偉在電台打歌，Vera 在後台等他。她問阿偉幾時得閒見面，阿偉要在陪伴她與趕下一個通告之間作出選擇。",
      "beats": [
        {
          "speaker": "Vera",
          "lines": [
            "你今晚打歌之後，還要趕下一個通告嗎？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "本來是，但如果你有事，我可以推遲。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "你幾時得閒見我？我們好像很久沒有好好坐下來說話了。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我知道，最近真的太忙，但我不是故意冷落你。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "我明白你的事業重要，但有時候我也需要你在我身邊。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_vera_crisis_stay",
          "label": "陪她：推遲通告，留下來陪 Vera",
          "effects": {
            "flags": [
              "flag_vera_stay"
            ],
            "stats": {
              "rel_vera": 2,
              "trust": 1
            }
          },
          "notes": "Vera 感受到阿偉的重視，關係更穩固。"
        },
        {
          "id": "C_vera_crisis_work",
          "label": "趕通告：顧形象與事業",
          "effects": {
            "flags": [
              "flag_vera_workfirst"
            ],
            "stats": {
              "music": 1,
              "rel_vera": -2
            }
          },
          "notes": "Vera 失望，覺得阿偉始終事業優先。"
        }
      ],
      "flags_written": [
        "flag_vera_stay",
        "flag_vera_workfirst"
      ],
      "artId": "rom_vera_crisis",
      "conflict": "T5",
      "romanceLine": "vera",
      "arcBeat": "crisis"
    },
    {
      "id": "R_vera_ending",
      "phase": "P5",
      "title": "造型間收工",
      "when": "1992",
      "setting": "造型間收工",
      "eraTag": "era_1992_finale",
      "cast": [
        "阿偉",
        "Vera"
      ],
      "synopsis": "阿偉與 Vera 在造型間收工後獨處。兩人回望過去幾年的點滴，阿偉可以選擇確定關係，還是保持現狀。",
      "beats": [
        {
          "speaker": "Vera",
          "lines": [
            "今天收工了，你還要趕下場嗎？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "不趕了，今晚留下來陪你。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "這幾年看著你由臨記走到這裡，我其實很替你高興。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "如果沒有你幫我整理形象，我可能還是那個草根臨記。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "那你自己呢？有沒有想過我們之間是甚麼關係？"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_vera_ending_he",
          "label": "確定關係：同 Vera 一起行落去",
          "effects": {
            "flags": [
              "flag_vera_he",
              "flag_vera_commit"
            ],
            "stats": {
              "rel_vera": 3
            }
          },
          "notes": "阿偉與 Vera 正式成為情侶，感情線開花結果。"
        },
        {
          "id": "C_vera_ending_be",
          "label": "保持現狀：專注事業，感情隨緣",
          "effects": {
            "flags": [
              "flag_vera_be"
            ],
            "stats": {
              "rel_vera": -2
            }
          },
          "notes": "Vera 明白阿偉的選擇，兩人退回朋友關係。"
        }
      ],
      "flags_written": [
        "flag_vera_he",
        "flag_vera_commit",
        "flag_vera_be"
      ],
      "artId": "rom_vera_ending",
      "conflict": null,
      "romanceLine": "vera",
      "arcBeat": "ending"
    }
  ]
}