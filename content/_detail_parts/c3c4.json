{
  "nodes": [
    {
      "id": "C3",
      "phase": "P1",
      "title": "通告板前",
      "when": "1988春 / W6-8",
      "setting": "星河電視台電影組通告板前，走廊人來人往",
      "eraTag": "era_1988_spring_factory",
      "cast": [
        "阿偉",
        "高俊傑",
        "林曉晴"
      ],
      "synopsis": "通告板貼出下周廠景名單。高俊傑當眾指阿偉走位慢，順手把阿偉的名牌從板上抽走。阿偉要決定硬碰還是忍讓。林曉晴在旁觀望，沒有出聲。",
      "beats": [
        {
          "speaker": "旁白",
          "lines": [
            "通告板前圍了十幾人。下周廠景名單剛貼上。",
            "阿偉的名牌掛在第三行，位置不算好，但總算有。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "阿偉，你上次走位慢了半拍。",
            "整組人等你一個。",
            "這塊板，我先替你收著。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "名牌還我。",
            "我走位慢，我會改。",
            "但名單不是你說抽就抽。"
          ]
        },
        {
          "speaker": "高俊傑",
          "lines": [
            "口氣不小。",
            "你知不知這塊板誰排的？",
            "想拿回去，自己問。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "走廊靜了一瞬。有人低頭看薄本，有人裝作沒聽見。",
            "林曉晴站在人群邊，目光在兩人身上來回。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "好。",
            "我記住今日。",
            "板上的名，我會自己掛回去。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C3_a",
          "label": "硬碰：當面要回名牌，把話說清楚",
          "effects": {
            "flags": [
              "rival_gao_hard"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "高俊傑關係惡化；對手開始注意你"
          }
        },
        {
          "id": "C3_b",
          "label": "忍讓：不爭一時，先記下走位問題",
          "effects": {
            "flags": [
              "rival_gao_endure"
            ],
            "stats": {
              "craft": 1
            },
            "notes": "壓力暫緩；你觀察到對手排板的習慣"
          }
        }
      ],
      "flags_written": [
        "rival_gao_hard",
        "rival_gao_endure"
      ],
      "artId": "story_c3",
      "conflict": null
    },
    {
      "id": "C4",
      "phase": "P1",
      "title": "何生拒單",
      "when": "1988春 / W8-9",
      "setting": "何生事務所，桌面堆著薄本與通告紙",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "何生",
        "阿偉"
      ],
      "synopsis": "何生帶來一份外判通告。工時寫得含糊，條款不清，片酬只有口頭承諾。何生主張拒單。阿偉可以跟何生，也可以自己硬接。",
      "beats": [
        {
          "speaker": "何生",
          "lines": [
            "這份通告，我看過。",
            "工時寫八小時，實際會拖到十六。",
            "片酬口頭講，紙上一個字都沒有。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "幾多錢？",
            "幾時出糧？",
            "有無寫落薄本？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "無。",
            "所以我不簽。",
            "你要接，我不攔。但別用我事務所的名。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我缺錢。",
            "但這張紙，確實有問題。",
            "何生，你覺得我應該點做？"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "我帶你入行，不是帶你入坑。",
            "拒了它。",
            "下張單，我幫你找。"
          ]
        },
        {
          "speaker": "旁白",
          "lines": [
            "何生把通告紙推回桌邊，沒有再說話。",
            "阿偉看著紙上那行模糊的工時，手指停在半空。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C4_a",
          "label": "跟何生拒單，等下一張乾淨通告",
          "effects": {
            "flags": [
              "flag_refuse_gig_with_ho"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "何生信任升；收入不增，短期手頭更緊"
          }
        },
        {
          "id": "C4_b",
          "label": "自己硬接，先賺一筆再算",
          "effects": {
            "flags": [
              "flag_take_harsh_gig"
            ],
            "stats": {
              "wealth": 1,
              "standing": -1
            },
            "notes": "收入升；何生信任降，日後難開口"
          }
        }
      ],
      "flags_written": [
        "flag_refuse_gig_with_ho",
        "flag_take_harsh_gig"
      ],
