{
  "nodes": [
    {
      "id": "C6",
      "phase": "P1.5",
      "title": "收工之後，約誰",
      "when": "1988秋 / W12-14",
      "setting": "單元劇錄影廠外走廊與化妝間；收工後茶餐廳、碼頭長椅",
      "eraTag": "era_1988_autumn_unitdrama",
      "cast": [
        "阿偉",
        "Vera",
        "林曉晴",
        "周采兒",
        "何生"
      ],
      "synopsis": "單元劇季進入中段，班底日夜圍讀、趕廠景。阿偉終於站穩臨記班底，收工後開始有人願意等他一起走。何生提醒他：時間有限，今晚只能約一個。",
      "beats": [
        {
          "speaker": "系統",
          "lines": [
            "單元劇季．第十二週。",
            "廠景收工，走廊燈一半已關。",
            "通告板貼著明天的圍讀時間。",
            "今晚，可以正式約一個人。"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "收工了。",
            "別在走廊站著。",
            "約人，就約一個。",
            "兩個都等，最難看。"
          ]
        },
        {
          "speaker": "Vera",
          "lines": [
            "我明天要試造型。",
            "今晚想先看幾件衣服。",
            "你若有空，陪我走一趟。",
            "不用太久。"
          ]
        },
        {
          "speaker": "林曉晴",
          "lines": [
            "明天那場，我幫你對一次台詞。",
            "對完可以吃點東西。",
            "茶餐廳，近廠。",
            "你決定。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "上次小訪沒問完。",
            "有些話，不方便在廠裡說。",
            "收工後喝杯茶吧。",
            "你來，我就等。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "（三個人都開了口。）",
            "（今晚只能去一處。）",
            "（先想清楚，再回話。）"
          ]
        },
        {
          "speaker": "系統",
          "lines": [
            "正式約會，只此一次。",
            "關係未定，不必急著承諾。",
            "選擇今晚的對象。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C6_a",
          "label": "約 Vera：陪她看造型，順路吃點東西",
          "effects": {
            "flags": [
              "date_vera_1"
            ],
            "stats": {
              "rel_vera": 2
            },
            "notes": "形象向小聚；不鎖死關係，最多留一句下次再約"
          }
        },
        {
          "id": "C6_b",
          "label": "約林曉晴：對完台詞，茶餐廳輕鬆一餐",
          "effects": {
            "flags": [
              "date_hiu_1"
            ],
            "stats": {
              "rel_hiu": 2
            },
            "notes": "同期演員式約會；互相帶通告，關係未定"
          }
        },
        {
          "id": "C6_c",
          "label": "約周采兒：小訪之後，私下喝茶",
          "effects": {
            "flags": [
              "date_choi_1"
            ],
            "stats": {
              "rel_choi": 2
            },
            "notes": "記者與臨記的私下茶；話題含蓄，不鎖死關係"
          }
        }
      ],
      "flags_written": [
        "date_vera_1",
        "date_hiu_1",
        "date_choi_1"
      ],
      "artId": "story_c6",
      "conflict": null
    },
    {
      "id": "C7",
      "phase": "P1.5",
      "title": "那張合約，先別簽",
      "when": "1988秋冬 / W14-16",
      "setting": "茶餐廳廂房；臨時片場走廊盡頭",
      "eraTag": "era_1988_winter_festive",
      "cast": [
        "阿偉",
        "雷勁",
        "何生"
      ],
      "synopsis": "賀歲檔籌備的風聲傳來，雷勁約阿偉到茶餐廳廂房，攤開一份獨立片班底合約。工時長、片酬對賭、排他綁約的雛形都寫在紙上。何生坐在一旁，沒有先開口。",
      "beats": [
        {
          "speaker": "系統",
          "lines": [
            "茶餐廳廂房。",
            "桌上只有一壺茶，和一份薄薄的合約。",
            "窗外是賀歲檔的海報草稿。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "我這部片，缺一個肯熬的班底。",
            "工時會長，你要有準備。",
            "片酬先壓低，賣座再分。",
            "簽了，就別接別人的戲。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "（薄本很薄。）",
            "（條件很重。）",
            "（他在看我的手。）"
          ]
        },
        {
          "speaker": "何生",
          "lines": [
            "合約，看清楚。",
            "字小的部分，最貴。",
            "你自己決定。",
            "我在這裡坐著。"
          ]
        },
        {
          "speaker": "雷勁",
          "lines": [
            "機會不等人。",
            "賀歲檔一開，位置就滿。",
            "今晚給個答覆。",
            "拖，也是一種答覆。"
          ]
        },
        {
          "speaker": "系統",
          "lines": [
            "拒絕、拖延、或勉強簽下。",
            "三條路，代價不同。",
            "這一節不判結局，只記方向。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C7_a",
          "label": "拒絕苛約：條件不改，就不簽",
          "effects": {
            "flags": [
              "flag_anti_lei"
            ],
            "stats": {
              "standing": 1
            },
            "notes": "守住底線；雷勁關係惡化，日後獨立片圈子會記得這件事"
          }
        },
        {
          "id": "C7_b",
          "label": "拖字訣：先說要問清楚，不給答覆",
          "effects": {
            "flags": [
              "flag_lei_delay"
            ],
            "stats": {},
            "notes": "中性過渡；把交鋒留到 P2 再攤牌，雷勁暫且按住"
          }
        },
        {
          "id": "C7_c",
          "label": "勉強簽下：先拿片酬，之後再算",
          "effects": {
            "flags": [
              "flag_lei_signed"
            ],
            "stats": {
              "wealth": 2,
              "standing": -1
            },
            "notes": "不鼓勵；短期有錢，信任與 standing 受損，後患留待 P2"
          }
        }
      ],
      "flags_written": [
