    {
      "id": "C5",
      "phase": "P1",
      "title": "采兒小訪題",
      "when": "1988夏 / W9-10",
      "setting": "片場邊的小桌，摺椅與保溫壺；午後光線偏白",
      "eraTag": "era_1988_summer_variety",
      "cast": [
        "周采兒",
        "阿偉"
      ],
      "synopsis": "星河台慶籌備的傳聞在片場流轉，獎項名單未到阿偉手上。周采兒好感足夠，約他在片場邊做一段小訪，只問片場日常與新人起步。她翻開薄本，筆尖停在第 一題。",
      "beats": [
        {
          "speaker": "周采兒",
          "lines": [
            "坐吧，十分鐘就夠。",
            "我只問日常，不問傳聞。",
            "你第一日入片場，最記得甚麼？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "熱。燈一開，背脊全濕。",
            "副導叫一次，我就跑一次。",
            "臨記站在邊位，等一個眼神。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "等一個眼神，這句好。",
            "有人說你近來多了通告。",
            "你自己怎樣看？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "通告多，不代表站得前。",
            "我還在學。",
            "學看機位，學收聲。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "星河台慶在籌備，你聽過吧。",
            "我不問名單。",
            "只問你想被記住成怎樣的人。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "（他停了一拍。）",
            "想被人記得：交得準。",
            "其他，我不敢講。"
          ]
        },
        {
          "speaker": "周采兒",
          "lines": [
            "好。最後一題。",
            "新人起步，最難是甚麼？",
            "你照直說就可以。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "最難是等。",
            "等一個鏡頭，等一句對白。",
            "等到有，就要接得住。"
          ]
        }
      ],
      "choices": [
