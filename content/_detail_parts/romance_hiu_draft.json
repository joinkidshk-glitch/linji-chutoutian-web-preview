{
  "nodes": [
    {
      "id": "R_hiu_meet",
      "phase": "P1",
      "title": "廠景休息角初遇",
      "when": "1988春",
      "setting": "廠景休息角",
      "eraTag": "era_1988_spring_grassroot",
      "cast": [
        "林曉晴",
        "我"
      ],
      "synopsis": "在廠景休息角，我與同期臨記林曉晴初次碰面。她主動搭話，透露一些通告情報，似乎想交換消息。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "你也是今天才來這個廠景嗎？我剛才聽到助導說，下午那場戲需要多幾個臨記。",
            "如果你有興趣，我可以幫你問問，不過你要快點決定，不然名額很快就被其他人搶走。"
          ]
        },
        {
          "speaker": "我",
          "lines": [
            "謝謝你告訴我，我確實想多接一些通告。你平時也是這樣到處打聽消息嗎？",
            "不如我們交換一下情報，你告訴我哪裡有機會，我也可以幫你留意其他廠景的需求。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_meet_a",
          "label": "交換情報",
          "effects": {
            "flags": [
              "hiu_meet_exchange"
            ],
            "stats": {
              "rel_hiu": 1
            }
          },
          "notes": "建立互助關係，林曉晴對你印象不錯。"
        },
        {
          "id": "C_hiu_meet_b",
          "label": "客氣疏離",
          "effects": {
            "flags": [
              "hiu_meet_distant"
            ],
            "stats": {
              "rel_hiu": 0
            }
          },
          "notes": "保持距離，沒有深入交流。"
        }
      ],
      "flags_written": [
        "hiu_meet_exchange",
        "hiu_meet_distant"
      ],
      "artId": "rom_hiu_meet",
      "conflict": "初次見面，是否信任對方並交換情報。",
      "romanceLine": "hiu",
      "arcBeat": "meet"
    },
    {
      "id": "R_hiu_push1",
      "phase": "P1.5",
      "title": "茶餐廳互相帶通告",
      "when": "1988秋",
      "setting": "茶餐廳／廠景後門",
      "eraTag": "era_1988_autumn_unit",
      "cast": [
        "林曉晴",
        "我"
      ],
      "synopsis": "我與林曉晴在茶餐廳碰面，互相分享通告情報。她提到一個試鏡機會，但名額有限，我們之間出現微妙的競爭。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "我聽說下星期有個試鏡，是星河電視台的新劇，需要幾個年輕臨記。",
            "我已經報了名，但如果你也想去，我們可以一起準備，不過名額好像只剩兩個。"
          ]
        },
        {
          "speaker": "我",
          "lines": [
            "謝謝你告訴我，這個機會很難得。你覺得我們應該怎樣準備？",
            "如果只有兩個名額，我們其中一個可能選不上，你會介意嗎？"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_push1_a",
          "label": "幫她讓位／報料",
          "effects": {
            "flags": [
              "hiu_push1_help"
            ],
            "stats": {
              "rel_hiu": 2
            }
          },
          "notes": "你主動幫林曉晴爭取機會，她對你更加信任。"
        },
        {
          "id": "C_hiu_push1_b",
          "label": "自己先搶",
          "effects": {
            "flags": [
              "hiu_push1_self"
            ],
            "stats": {
              "rel_hiu": -1,
              "standing": 1
            }
          },
          "notes": "你優先為自己爭取，事業上有進展，但林曉晴有點失望。"
        }
      ],
      "flags_written": [
        "hiu_push1_help",
        "hiu_push1_self"
      ],
      "artId": "rom_hiu_push1",
      "conflict": "面對有限機會，選擇成全對方還是自己爭取。",
      "romanceLine": "hiu",
      "arcBeat": "push"
    },
    {
      "id": "R_hiu_push2",
      "phase": "P2",
      "title": "夜班殺青後",
      "when": "1989",
      "setting": "夜班殺青後",
      "eraTag": "era_1989_summer",
      "cast": [
        "林曉晴",
        "我"
      ],
      "synopsis": "夜班殺青後，我與林曉晴一起收拾東西，氣氛輕鬆。她主動聊起私人生活，關係似乎可以更進一步。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "今晚的夜班真的很累，不過總算殺青了。你接下來有什麼打算？",
            "我聽說附近有間糖水店開到很晚，要不要一起去吃點東西？"
          ]
        },
        {
          "speaker": "我",
          "lines": [
            "好啊，我也覺得有點餓。不過你平時不是急著回家嗎？",
            "如果你不趕時間，我們可以慢慢聊，順便交換一下最近聽到的消息。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_push2_a",
          "label": "約下次",
          "effects": {
            "flags": [
              "hiu_push2_date"
            ],
            "stats": {
              "rel_hiu": 2
            }
          },
          "notes": "你主動約林曉晴下次見面，關係升溫。"
        },
        {
          "id": "C_hiu_push2_b",
          "label": "只當同期",
          "effects": {
            "flags": [
              "hiu_push2_friend"
            ],
            "stats": {
              "rel_hiu": 0
            }
          },
          "notes": "你保持普通朋友關係，沒有進一步表示。"
        }
      ],
      "flags_written": [
        "hiu_push2_date",
        "hiu_push2_friend"
      ],
      "artId": "rom_hiu_push2",
      "conflict": "是否將關係從工作夥伴推向私人約會。",
      "romanceLine": "hiu",
      "arcBeat": "push"
    },
    {
      "id": "R_hiu_crisis",
      "phase": "P3–P4",
      "title": "同場搶通告",
      "when": "1990–1991",
      "setting": "同場搶通告／試鏡廊",
      "eraTag": "era_1991_summer_anni",
      "cast": [
        "林曉晴",
        "我"
      ],
      "synopsis": "在試鏡廊，我與林曉晴同時爭取一個重要的角色。兩人面對直接競爭，關係受到考驗。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "沒有想到我們會在這裡碰面，這個角色對我很重要，我已經準備了很久。",
            "我知道你也想要這個機會，但我們只能有一個被選中，你會怎樣做？"
          ]
        },
        {
          "speaker": "我",
          "lines": [
            "我明白你的心情，這個角色確實很難得。但我們都是專業的，應該公平競爭。",
            "無論結果如何，我希望我們不會因為這件事影響關係。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_crisis_a",
          "label": "成全她",
          "effects": {
            "flags": [
              "hiu_crisis_yield"
            ],
            "stats": {
              "rel_hiu": 2,
              "standing": -1
            }
          },
          "notes": "你主動退出競爭，林曉晴感激，但你的事業發展稍受影響。"
        },
        {
          "id": "C_hiu_crisis_b",
          "label": "硬搶同場",
          "effects": {
            "flags": [
              "hiu_crisis_fight"
            ],
            "stats": {
              "rel_hiu": -2,
              "standing": 2
            }
          },
          "notes": "你全力爭取，事業上有突破，但與林曉晴關係緊張。"
        }
      ],
      "flags_written": [
        "hiu_crisis_yield",
        "hiu_crisis_fight"
      ],
      "artId": "rom_hiu_crisis",
      "conflict": "事業機會與感情之間的取捨。",
      "romanceLine": "hiu",
      "arcBeat": "crisis"
    },
    {
      "id": "R_hiu_ending",
      "phase": "P5",
      "title": "廠景天台",
      "when": "1992",
      "setting": "廠景天台",
      "eraTag": "era_1992_finale",
      "cast": [
        "林曉晴",
        "我"
      ],
      "synopsis": "在廠景天台，我與林曉晴回顧過去幾年的點滴，決定是否要確立關係。",
      "beats": [
        {
          "speaker": "林曉晴",
          "lines": [
            "這幾年我們一起經歷了很多，從臨記到現在，大家都有了不少改變。",
            "我不知道你有沒有想過，我們之間的關係可以走到哪裡？"
          ]
        },
        {
          "speaker": "我",
          "lines": [
            "我當然有想過，你一直是我很重要的夥伴，也是我很在意的人。",
            "如果你願意，我想我們可以嘗試一起走下去，無論事業怎樣，都互相支持。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_hiu_ending_he",
          "label": "確定關係",
          "effects": {
            "flags": [
              "flag_hiu_he",
              "flag_hiu_commit"
            ],
            "stats": {
              "rel_hiu": 3
            }
          },
          "notes": "HE：與林曉晴成為戀人，感情穩定，可與事業並存。"
        },
        {
          "id": "C_hiu_ending_be",
          "label": "保持距離",
          "effects": {
            "flags": [
              "flag_hiu_be"
            ],
            "stats": {
              "rel_hiu": -2
            }
          },
          "notes": "BE：兩人沒有進一步發展，關係轉淡。"
        }
      ],
      "flags_written": [
        "flag_hiu_he",
        "flag_hiu_commit",
        "flag_hiu_be"
      ],
      "artId": "rom_hiu_ending",
      "conflict": "是否將多年感情昇華為戀人關係。",
      "romanceLine": "hiu",
      "arcBeat": "ending"
    }
  ]
