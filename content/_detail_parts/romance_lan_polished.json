{
  "nodes": [
    {
      "id": "R_lan_meet",
      "title": "唱片店外的傘",
      "synopsis": "阿偉為避雨衝入唱片店，撞見藍若曦被狗仔隊追訪。她情急之下躲到他傘下，阿偉順勢掩護她離開。",
      "beats": [
        {
          "speaker": "藍若曦",
          "lines": [
            "不好意思，可以借你的傘擋一擋嗎？對面那幾個記者已經跟了我整條街。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "你躲進來吧，我剛好要過馬路，順路遮你到前面街口。"
          ]
        },
        {
          "speaker": "藍若曦",
          "lines": [
            "多謝你，我叫藍若曦，今日真的麻煩你了。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我叫阿偉，做臨記的。你這行也不容易，連落雨都要避鏡頭。"
          ]
        },
        {
          "speaker": "藍若曦",
          "lines": [
            "習慣了。不過今日遇到你，總算沒有那麼狼狽。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lan_meet_warm",
          "label": "溫柔接住：叫她放心，慢慢行",
          "effects": {
            "flags": [
              "flag_lan_met_warm"
            ],
            "stats": {
              "rel_lan": 1,
              "craft": 0
            },
            "notes": "阿偉語氣溫柔，藍若曦留下好感。"
          }
        },
        {
          "id": "C_lan_meet_cool",
          "label": "客氣疏離：遮到街口就告辭",
          "effects": {
            "flags": [
              "flag_lan_met_cool"
            ],
            "stats": {
              "rel_lan": 0,
              "craft": 0
            },
            "notes": "阿偉保持距離，藍若曦只覺他好人。"
          }
        }
      ],
      "arcBeat": "meet",
