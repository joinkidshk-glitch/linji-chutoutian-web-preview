    {
      "id": "R_lan_push2",
      "title": "假戲與真話",
      "synopsis": "公司建議兩人以情侶檔姿態出席活動，藍若曦猶豫，阿偉要決定是否護她。",
      "beats": [
        {
          "speaker": "藍若曦",
          "lines": [
            "公司想我們認拍拖來宣傳新劇，但我怕認了之後，以後分手會更難看。"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "如果你不想，我幫你擋，話我單方面追求你，你沒有答應。"
          ]
        },
        {
          "speaker": "藍若曦",
          "lines": [
            "你這樣說，記者只會更加追住你不放，你頂得住嗎？"
          ]
        },
        {
          "speaker": "阿偉",
          "lines": [
            "我一個臨記，沒有什麼好怕。你不同，你是女主角，形象要緊。"
          ]
        },
        {
          "speaker": "藍若曦",
          "lines": [
            "你這樣講，我反而不知道怎樣答你。"
          ]
        }
      ],
      "choices": [
        {
          "id": "C_lan_push2_protect",
          "label": "護她：對外認曖昧，把壓力攬上身",
          "effects": {
