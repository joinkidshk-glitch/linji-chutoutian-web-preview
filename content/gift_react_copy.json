      "narration": null,
      "id": "GR-vera-memo｜neutral"
    },
    {
      "npcKey": "vera",
      "itemId": "gift_thermos",
      "pref": "neutral",
      "lines": [
        "Vera：「實用就好。造型間很乾，有熱水比什麼都實際。」",
        "Vera：「我收下。你自己也記得喝水，別整天只靠汽水撐。」"
      ],
      "narration": null,
      "id": "GR-vera-thermos｜neutral"
    },
    {
