    "choi:gift_coffee_beans:liked": {
      "npcKey": "choi",
      "itemId": "gift_coffee_beans",
      "pref": "liked",
      "lines": [
        "周采兒：「蘭芳的豆？你有做功課。夜更截稿前，就靠這個提神。」",
        "周采兒：「別指望我寫软文回報你。不過這包豆，我會煮完才睡。」"
